---
import { getCollection } from 'astro:content';
import ServicePage from '../../components/ServicePage.astro';
import Button from '../../components/Button.astro';
import { sortWorkflows } from '../../lib/library';
const workflows = sortWorkflows(await getCollection('workflows'));
---
<ServicePage
  id="flow"
  kicker="Stap 2: bouwen"
  headline="Een workflow die je opvolging overneemt,"
  accent="gebouwd in drie weken."
  title="Flow: workflows laten bouwen | Workflow Factory"
  description="Voor B2B-bedrijven met contracten en service: een workflow gebouwd in jouw CRM, zodat opvolging niet meer blijft liggen. Vaste prijs, 3 weken."
  signalsTitle="Je hebt een opvolgingsprobleem als:"
  signals={[
    'Een aanvraag ligt soms dagen voordat iemand belt.',
    'Offertes gaan de deur uit en daarna hoor je niets meer.',
    'Contracten lopen af zonder dat iemand het merkt.',
    'Je hebt een CRM, maar het is vooral een duur adresboek.',
  ]}
  deliverablesTitle="Na drie weken draait er een workflow"
  processTitle="Zo zien de drie weken er precies uit"
  priceTitle="Vaste prijs per workflow"
  priceIntro="De prijs hangt af van hoeveel systemen en velden de workflow raakt. Dat weten we na de flowspecificatie."
>
  <div slot="after-deliverables" class="mt-16 grid gap-8 md:grid-cols-[16rem_1fr]">
    <div>
      <h3 class="text-3xl">De open workflowbibliotheek</h3>
      <p class="mt-4 text-fg/80">Kies een workflow. Elke workflow heeft een eigen pagina met de trigger, de stappen en wat het dashboard meet.</p>
    </div>
    <div>
      <ul class="border-b border-fg/15">
        {workflows.map((j) => (
          <li class="border-t border-fg/15">
            <a href={`/workflows/${j.id}/`} class="group flex items-center justify-between gap-4 py-4 text-lg hover:text-accent">
              <span>{j.data.name}{!j.data.needs_blueprint && <span class="ml-3 rounded-md bg-mint px-2 py-0.5 align-middle text-[11px] font-semibold text-forest">Kan meteen</span>}</span>
              <span aria-hidden="true" class="text-muted transition-transform group-hover:text-accent motion-safe:group-hover:translate-x-0.5">→</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-8"><Button href="/workflows/" variant="ghost-light">Bekijk de workflowbibliotheek</Button></div>
    </div>
  </div>
  <div slot="after-price" class="mt-10 flex flex-col gap-4 rounded-xl border border-accent/40 bg-accent/10 p-8 md:flex-row md:items-center md:justify-between">
    <p class="font-display text-3xl">Pilot</p>
    <p class="max-w-xl text-fg/85">De eerste drie klanten betalen de helft. In ruil daarvoor maken we samen een case met cijfers, en gaat jouw workflow in de bibliotheek van concept naar getest.</p>
  </div>
</ServicePage>
