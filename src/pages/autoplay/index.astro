---
import ServicePage from '../../components/ServicePage.astro';
---
<ServicePage
  id="autoplay"
  headline="Autoplay. Het verhaal, elke dag,"
  accent="tot de tweede order."
  title="Autoplay · Marketing automation in HubSpot of ActiveCampaign | neon"
  description="Autoplay: journeys in HubSpot of ActiveCampaign voor leadopvolging, offerteopvolging, onboarding, contractverlenging en nabestellingen. 3 weken per journey."
  signals={[
    'Aanvragen en offertes blijven liggen.',
    'Je hebt HubSpot, maar weet niet wat je erin moet zetten.',
    'Contracten lopen af zonder dat iemand belt.',
    'Je weet niet hoeveel aanvragen een order worden, of hoe lang dat duurt.',
  ]}
>
  <div slot="after-deliverables" class="mt-16 grid gap-8 md:grid-cols-[16rem_1fr]">
    <h3 class="text-3xl">Voorbeelden van journeys</h3>
    <div>
      <ul class="border-b border-paper/15">
        {['Leadopvolging', 'Offerteopvolging', 'Onboarding', 'Contractverlenging', 'Nabestellingen'].map((j) => (
          <li class="border-t border-paper/15 py-4 text-lg">{j}</li>
        ))}
      </ul>
      <p class="mt-6 text-paper/80">Ik werk in HubSpot of ActiveCampaign. Geen Salesforce.</p>
    </div>
  </div>
  <div slot="after-price" class="mt-10 flex flex-col gap-4 rounded-3xl border border-mint/40 bg-mint/10 p-8 md:flex-row md:items-center md:justify-between">
    <p class="font-serif text-3xl">Pilot</p>
    <p class="max-w-xl text-paper/85">De eerste drie klanten betalen de helft. In ruil daarvoor maken we samen een case met cijfers.</p>
  </div>
</ServicePage>
