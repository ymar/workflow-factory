---
import ServicePage from '../../components/ServicePage.astro';
---
<ServicePage
  id="rewind"
  kicker="Startpunt"
  headline="Rewind. Vind het verhaal dat er al is."
  title="Rewind · Positionering en homepage in 2 weken | Neeeon"
  description="Rewind: terug naar waar je bedrijf begon, om te vinden wat geen concurrent kan kopiëren. Daarna herschrijven we je homepage. 2 weken."
  signals={[
    'Je concurreert vooral op prijs.',
    'Je website klinkt als die van de concurrent.',
    'Je weet niet goed welk verhaal je moet vertellen.',
    'Campagnes leveren weinig reacties op.',
  ]}
>
  <div slot="after-deliverables" class="mt-10 max-w-2xl">
    <h3 class="text-2xl">De vier checks</h3>
    <ol class="mt-4 list-decimal space-y-2 pl-6 text-lg">
      <li>Klopt het?</li>
      <li>Maakt het verschil voor de koper?</li>
      <li>Kan een concurrent het zeggen?</li>
      <li>Wint het ook de tweede order?</li>
    </ol>
    <p class="mt-4 text-ink/85">Ongeveer 6 uur van jouw tijd. Het schrijven doen wij.</p>
  </div>
</ServicePage>
