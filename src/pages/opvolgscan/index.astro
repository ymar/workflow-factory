---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import Faq from '../../components/Faq.astro';
import NotFor from '../../components/NotFor.astro';
import { scan } from '../../lib/offer';
import { metricAnchor } from '../../lib/library';

const metricIds = ['tijd_tot_eerste_contact', 'dagen_offerte_tot_beslissing', 'dagen_voorstel_tot_verlenging', 'verlengd_voor_einddatum', 'offerte_winratio', 'omzet_bestaande_klanten'];
const allMetrics = new Map((await getCollection('metrics')).map((m) => [m.id, m]));
const baseline = metricIds.map((id) => allMetrics.get(id)).filter((m): m is NonNullable<typeof m> => Boolean(m));

const faq = (await getCollection('faq')).filter((f) => f.data.page === 'scan').sort((a, b) => a.data.order - b.data.order);
const crumbs: [string, string][] = [['/', 'Home'], ['/diensten/', 'Diensten'], [scan.slug, scan.name]];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map(([href, label], i) => ({ '@type': 'ListItem', position: i + 1, name: label, item: new URL(href, Astro.site).href })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: scan.name,
    description: 'Een scan van waar aanvragen, offertes en facturen blijven liggen, met de drie grootste lekken en de workflow die elk lek dicht.',
    provider: { '@type': 'ProfessionalService', name: 'Workflow Factory' },
    areaServed: 'NL',
  },
  ...(faq.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.data.question, acceptedAnswer: { '@type': 'Answer', text: f.data.answer } })),
      }]
    : []),
];
---
<Base
  title="Opvolgscan: waar blijft jouw opvolging liggen? | Workflow Factory"
  description="De opvolgscan laat in 30 minuten zien waar aanvragen, offertes en facturen blijven liggen, wat dat per jaar kost en welke workflow elk lek dicht."
  path="/opvolgscan/"
  jsonLd={jsonLd}
>
  <PageHero
    crumbs={crumbs}
    kicker="Stap 1 · 30 minuten"
    title="Zie waar je opvolging blijft liggen,"
    accent="en wat dat per jaar kost."
    intro="Aanvragen, offertes en facturen blijven liggen tot iemand eraan denkt. In de opvolgscan rekenen we met je eigen cijfers uit waar dat gebeurt. Je houdt één pagina over met de drie grootste lekken en de workflow die elk lek dicht."
  >
    <Button href="/contact/">Plan de scan</Button>
    <Button href="/workflows/" variant="ghost-dark">Bekijk de workflows</Button>
  </PageHero>

  <Section id="kijken" n="01" label="Waar we naar kijken" title="Drie plekken waar opvolging blijft liggen">
    <ul class="grid gap-4 md:grid-cols-3">
      {[
        ['Aanvragen', 'Hoe snel wordt een aanvraag gebeld, en hoeveel blijven er liggen zonder reactie?'],
        ['Offertes', 'Welke offertes krijgen een vaste opvolging tot ja of nee, en welke gaan de deur uit en worden vergeten?'],
        ['Facturen en contracten', 'Welke facturen worden te laat betaald, en welke contracten lopen af zonder dat iemand belt?'],
      ].map(([title, text]) => (
        <li class="rounded-xl border-2 border-fg bg-white p-8">
          <h3 class="text-2xl">{title}</h3>
          <p class="mt-3 text-fg/80">{text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="nulmeting" n="02" label="De nulmeting" title="Eerst meten hoe snel het loopt" intro="Een zwakke opvolging is zelden een kwestie van te weinig aanvragen. Meestal gaat het te langzaam. Daarom meten we eerst doorlooptijden, en pas daarna volume.">
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {baseline.map((m) => (
        <li class="rounded-xl border-2 border-fg bg-white p-6">
          <p class="text-[13px] font-medium text-muted">{m.data.type === 'doorlooptijd' ? 'Doorlooptijd' : m.data.type === 'conversie' ? 'Conversie' : m.data.type === 'omzet' ? 'Omzet' : 'Volume'}</p>
          <p class="mt-2 text-lg font-bold leading-snug"><a href={`/workflows/data/#${metricAnchor(m.id)}`} class="hover:text-accent hover:underline">{m.data.label}</a></p>
        </li>
      ))}
    </ul>
    <p class="mt-6 max-w-2xl text-fg/80">Elke meting is gedefinieerd in de bibliotheek. Het cijfer van vandaag is je nulmeting. Het doel dat we per lek afspreken, is geen garantie. Het is de afspraak waaraan je het resultaat kunt toetsen.</p>
  </Section>

  <Section id="oplevering" n="03" label="Oplevering" title="Eén pagina met de drie grootste lekken">
    <div class="grid gap-10 md:grid-cols-12">
      <ol class="border-b border-fg/15 md:col-span-7">
        {[
          'Per lek: wat het per jaar kost, met jouw cijfers.',
          'Per lek: de workflow uit de bibliotheek die het dicht.',
          'Per lek: een afgesproken doel, met je nulmeting als begin en de meting die het bewijst.',
          'Welke je eerst bouwt, en waarom.',
        ].map((s, i) => (
          <li class="grid grid-cols-[3rem_1fr] border-t border-fg/15 py-5 text-lg"><span class="text-fg/70">0{i + 1}</span>{s}</li>
        ))}
      </ol>
      <aside class="self-start rounded-xl border border-accent/30 bg-accent/5 p-8 md:col-span-5">
        <p class="text-[13px] font-medium text-accent">Voorbeeld van de rekensom</p>
        <p class="mt-4 text-lg leading-snug">Stel: 400 contracten van €1.200. Elk procentpunt dat je meer verlengt, is €4.800 per jaar.</p>
      </aside>
    </div>
  </Section>

  <Section id="verloop" n="04" label="Verloop" title="Zo gaat het">
    <ol class="border-b border-fg/15">
      {[
        ['Vooraf', 'Je stuurt een paar cijfers: aanvragen en offertes per maand, het gemiddelde bedrag, het aantal contracten.', '10 min'],
        ['Het gesprek', 'We lopen je opvolging door, van aanvraag tot factuur, en rekenen de lekken uit.', `${scan.minutes} min`],
        ['Daarna', 'Je krijgt de pagina met de drie lekken en de workflow die elk lek dicht.', 'Geen'],
      ].map(([when, what, time]) => (
        <li class="grid gap-1 border-t border-fg/15 py-5 md:grid-cols-[16rem_1fr_12rem] md:gap-8">
          <span class="font-medium">{when}</span>
          <span class="text-fg/80">{what}</span>
          <span class="text-sm text-fg/70 md:text-right">Jouw tijd: {time}</span>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="niet" n="05" label="Voor wie" title="Past de scan bij jou?">
    <NotFor />
  </Section>

  <Section id="prijs" n="06" label="Prijs" tone="dark" title={scan.price}>
    <p class="max-w-2xl text-fg/80">Dit is een voorstel. Daarna volgt een prijs, die we in de kennismaking bevestigen. Je bent niets verplicht na de scan: je kunt de workflows zelf bouwen, ze zijn open.</p>
    <div class="mt-8"><Button href="/contact/">Plan de scan</Button></div>
  </Section>

  {faq.length > 0 && (
    <Section id="vragen" n="07" label="Vragen" title="Vragen over de scan">
      <Faq items={faq.map((f) => ({ question: f.data.question, answer: f.data.answer }))} />
    </Section>
  )}
</Base>
