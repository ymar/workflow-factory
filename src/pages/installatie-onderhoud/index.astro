---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';

const segment = await getEntry('segments', 'installatie-onderhoud');
if (!segment) throw new Error('Missing segments/installatie-onderhoud.json');
const { name, problems, journeys, glossary } = segment.data;
const faq = (await getCollection('faq')).filter((f) => f.data.page === 'segment').sort((a, b) => a.data.order - b.data.order);
const title = 'Marketing automation voor installatie- en onderhoudsbedrijven | Neeeon';
const description =
  'Voor installatie- en onderhoudsbedrijven: van opleverdatum, onderhoudscontract en jaarlijkse keuring naar opvolging die vanzelf loopt.';
const jsonLd = faq.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.data.question, acceptedAnswer: { '@type': 'Answer', text: f.data.answer } })),
    }]
  : [];
---
<Base title={title} description={description} path="/installatie-onderhoud/" jsonLd={jsonLd}>
  <section class="on-dark pb-16 pt-14 md:pb-20 md:pt-20">
    <div class="mx-auto max-w-5xl px-4 md:px-6">
      <p class="text-sm font-medium uppercase tracking-widest text-sage">{name}</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-medium md:text-6xl">Je werkt met datums. Gebruik ze.</h1>
      <p class="mt-6 max-w-2xl text-lg text-paper/90 md:text-xl">
        Opleverdatums, contracten en keuringen. Je systeem kent ze al. Elke datum kan een volgende stap starten.
      </p>
      <div class="mt-8">
        <a href="/contact/" class="inline-block rounded-md bg-mint px-5 py-3 font-semibold text-forest hover:brightness-110">Plan een kennismaking</a>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20" aria-labelledby="herken">
    <div class="mx-auto max-w-5xl px-4 md:px-6">
      <h2 id="herken" class="text-3xl md:text-4xl">Wat we vaak horen</h2>
      <ul class="mt-8 max-w-2xl space-y-4 font-serif text-2xl">
        {problems.map((p) => <li class="border-l-2 border-ink pl-4">"{p}"</li>)}
      </ul>
    </div>
  </section>

  <section class="border-t border-ink/15 py-16 md:py-20" aria-labelledby="woordenlijst">
    <div class="mx-auto max-w-5xl px-4 md:px-6">
      <h2 id="woordenlijst" class="text-3xl md:text-4xl">Jouw woorden, in het systeem</h2>
      <p class="mt-3 max-w-2xl text-ink/80">Elk begrip uit je vak wordt een trigger. Dit zijn voorbeelden, geen vaste regels.</p>
      <dl class="mt-10 divide-y divide-ink/20 border-y border-ink/20">
        {glossary.map((g) => (
          <div class="grid gap-2 py-5 md:grid-cols-[14rem_1fr] md:gap-6">
            <dt class="font-serif text-2xl">{g.term}</dt>
            <dd class="text-ink/85">{g.becomes}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="on-dark py-16 md:py-20" aria-labelledby="journeys">
    <div class="mx-auto max-w-5xl px-4 md:px-6">
      <h2 id="journeys" class="text-3xl md:text-4xl">Journeys die hier passen</h2>
      <ul class="mt-8 max-w-2xl space-y-3 text-lg">
        {journeys.map((j) => <li>{j}</li>)}
      </ul>
      <p class="mt-8 max-w-2xl text-sage">
        Eén uitzondering op "eerst het verhaal": opvolging van aanvragen en offertes kan meteen.
        De rest begint bij <a href="/rewind/" class="text-mint underline underline-offset-4">Rewind</a>.
      </p>
    </div>
  </section>

  {faq.length > 0 && (
    <section class="py-16 md:py-20" aria-labelledby="vragen">
      <div class="mx-auto max-w-3xl px-4 md:px-6">
        <h2 id="vragen" class="text-3xl md:text-4xl">Vragen</h2>
        <div class="mt-8"><Faq items={faq.map((f) => ({ question: f.data.question, answer: f.data.answer }))} /></div>
      </div>
    </section>
  )}
</Base>
