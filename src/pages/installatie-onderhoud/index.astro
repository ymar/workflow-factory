---
import { getCollection, getEntries, getEntry } from 'astro:content';
import { fieldAnchor } from '../../lib/library';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import Faq from '../../components/Faq.astro';

const segment = await getEntry('segments', 'installatie-onderhoud');
if (!segment) throw new Error('Missing segments/installatie-onderhoud.json');
const { name, problems, glossary } = segment.data;
const workflows = await getEntries(segment.data.workflows);
const fieldLabels = new Map((await getCollection('fields')).map((f) => [f.id, f.data.label]));
const faq = (await getCollection('faq')).filter((f) => f.data.page === 'segment').sort((a, b) => a.data.order - b.data.order);
const title = 'Marketing automation voor installateurs | Workflow Factory';
const description =
  'Voor installatie- en onderhoudsbedrijven: van opleverdatum, onderhoudscontract en jaarlijkse keuring naar opvolging die vanzelf loopt.';
const jsonLd = faq.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.data.question, acceptedAnswer: { '@type': 'Answer', text: f.data.answer } })),
    }]
  : [];
---
<Base title={title} description={description} path="/installatie-onderhoud/" jsonLd={jsonLd}>
  <PageHero
    kicker={name}
    title="Je werkt met datums."
    accent="Gebruik ze."
    intro="Opleverdatums, contracten en keuringen. Je systeem kent ze al. Elke datum kan een volgende stap starten."
  >
    <Button href="/contact/">Plan een kennismaking</Button>
  </PageHero>

  <Section id="herken" n="01" label="Wat we vaak horen" title="Wat we vaak horen">
    <ul class="border-b border-fg/15">
      {problems.map((p) => <li class="border-t border-fg/15 py-5 font-display text-2xl md:text-3xl">"{p}"</li>)}
    </ul>
  </Section>

  <Section id="woordenlijst" n="02" label="Woordenlijst" title="Jouw woorden, in het systeem" intro="Elk begrip uit je vak wordt een trigger. Dit zijn voorbeelden, geen vaste regels.">
    <dl class="border-b border-fg/15">
      {glossary.map((g) => (
        <div class="grid gap-2 border-t border-fg/15 py-6 md:grid-cols-[16rem_1fr] md:gap-8">
          <dt class="font-display text-3xl">{g.term}</dt>
          <dd class="text-fg/80 md:text-lg">
            {g.becomes}
            <span class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
              {g.field && <a href={`/workflows/data/#${fieldAnchor(g.field.id)}`} class="font-medium text-muted hover:text-accent hover:underline">In het systeem: {fieldLabels.get(g.field.id)}</a>}
              {g.workflow && <a href={`/workflows/${g.workflow.id}/`} class="font-medium text-accent hover:underline">Bekijk de workflow →</a>}
            </span>
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="workflows" n="03" label="Workflows" tone="dark" title="Workflows die hier passen">
    <ul class="border-b border-fg/15">
      {workflows.map((j) => (
        <li class="border-t border-fg/15">
          <a href={`/workflows/${j.id}/`} class="group flex items-center justify-between gap-4 py-5 font-display text-2xl hover:text-accent md:text-3xl">
            {j.data.name}<span aria-hidden="true" class="text-muted group-hover:text-accent">→</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-10 max-w-2xl text-muted">
      Eén uitzondering op "eerst de positionering": opvolging van aanvragen en offertes kan meteen.
      De rest begint bij <a href="/blueprint/" class="text-accent underline underline-offset-4">Blueprint</a>.
    </p>
  </Section>

  {faq.length > 0 && (
    <Section id="vragen" n="04" label="Vragen" title="Vragen">
      <Faq items={faq.map((f) => ({ question: f.data.question, answer: f.data.answer }))} />
    </Section>
  )}
</Base>
