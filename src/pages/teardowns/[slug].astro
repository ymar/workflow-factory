---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import KapotteLetters from '../../components/KapotteLetters.astro';
import { toParts } from '../../lib/kapot';

export async function getStaticPaths() {
  const teardowns = await getCollection('teardowns', (t) => !t.data.draft);
  return teardowns.map((t) => ({ params: { slug: t.id }, props: { teardown: t } }));
}

const { teardown } = Astro.props;
const { title, date, company, type, scorecard, before, after, lesson } = teardown.data;
const { Content } = await render(teardown);
const total = scorecard.reduce((sum, s) => sum + s.score, 0);
const fmt = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={`${title} · Teardown | Neeeon`} description={lesson} path={`/teardowns/${teardown.id}/`}>
  <article>
    <header class="on-dark pb-16 pt-14 md:pb-20 md:pt-20">
      <div class="mx-auto max-w-3xl px-4 md:px-6">
        <p class="text-sm text-sage">{fmt.format(date)} · {type} · {company}</p>
        <h1 class="mt-4 text-4xl font-medium md:text-5xl">{title}</h1>
        <div class="mt-10">
          <p class="text-sm font-medium uppercase tracking-widest text-sage">Voor</p>
          <div class="mt-3"><KapotteLetters parts={toParts(before)} label={before.replace(/[~*]/g, '')} /></div>
        </div>
      </div>
    </header>
    <div class="mx-auto max-w-3xl px-4 py-16 md:px-6">
      <h2 class="text-3xl">Scorekaart</h2>
      <table class="mt-6 w-full text-left">
        <caption class="sr-only">Score per criterium, van 0 tot 5</caption>
        <thead><tr class="border-b border-ink/30 text-sm text-ink/70"><th class="py-2 font-medium">Criterium</th><th class="py-2 text-right font-medium">Score</th></tr></thead>
        <tbody>
          {scorecard.map((s) => (
            <tr class="border-b border-ink/15"><td class="py-3 pr-4">{s.criterion}</td><td class="py-3 text-right font-semibold">{s.score} / 5</td></tr>
          ))}
        </tbody>
        <tfoot><tr><td class="py-3 font-semibold">Totaal</td><td class="py-3 text-right font-semibold">{total} / 25</td></tr></tfoot>
      </table>
      <h2 class="mt-14 text-3xl">Na</h2>
      <p class="mt-4 font-serif text-2xl">{after}</p>
      <h2 class="mt-14 text-3xl">De les</h2>
      <p class="mt-4 text-lg">{lesson}</p>
      <div class="mt-10 max-w-prose space-y-4 text-ink/85"><Content /></div>
    </div>
  </article>
</Base>
