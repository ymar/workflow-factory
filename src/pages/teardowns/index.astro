---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import KapotteLetters from '../../components/KapotteLetters.astro';
import Placeholder from '../../components/Placeholder.astro';

const teardowns = (await getCollection('teardowns', (t) => !t.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="Teardowns · Kapotte letters | neon"
  description="Kapotte letters: teardowns van B2B-websites. Welke woorden zegt iedereen, en wat blijft er over dat alleen dit bedrijf kan zeggen?"
  path="/teardowns/"
>
  <PageHero
    kicker="Teardowns"
    title="Kapotte letters."
    intro="Ik zet de woorden die iedereen gebruikt uit. Wat blijft branden, is wat alleen dit bedrijf kan zeggen. Vaak is dat weinig."
  />
  <div>
    <div class="mx-auto max-w-6xl px-4 pb-24 md:px-8 md:pb-32">
      <div class="border-t border-paper/15 pt-10">
        <KapotteLetters
          parts={[
            { text: 'Wij leveren ' }, { text: 'kwaliteit' }, { text: ' en ' }, { text: 'betrouwbare' }, { text: ' ' },
            { text: 'oplossingen' }, { text: '. We ' }, { text: 'ontzorgen' }, { text: ' je. ' },
            { text: 'Wat blijft er over?', lit: true },
          ]}
          label="Voorbeeld: een zin met uitgeschakelde woorden"
        />
      </div>
    </div>
  </div>

  <Section id="lijst" n="01" label="Archief" title="Alle teardowns">
    <ul class="border-b border-paper/15">
      {teardowns.length > 0
        ? teardowns.map((t) => (
            <li class="border-t border-paper/15">
              <a href={`/teardowns/${t.id}/`} class="group grid gap-2 py-6 md:grid-cols-[12rem_1fr_auto] md:items-baseline md:gap-8">
                <span class="text-sm text-paper/70">{fmt.format(t.data.date)}</span>
                <span class="font-display text-2xl group-hover:underline md:text-3xl">{t.data.title}</span>
                <span class="text-sm text-paper/70">{t.data.type}</span>
              </a>
            </li>
          ))
        : [1, 2, 3].map((n) => (
            <li class="grid gap-2 border-t border-paper/15 py-6 md:grid-cols-[12rem_1fr_auto] md:gap-8">
              <span class="text-sm text-paper/70">Nog niet gepubliceerd</span>
              <span class="font-display text-2xl md:text-3xl"><Placeholder label={`Teardown ${n}: titel`} /></span>
            </li>
          ))}
    </ul>
  </Section>
</Base>
