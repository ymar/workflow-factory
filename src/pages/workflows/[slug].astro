---
import { getCollection, getEntries, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import Faq from '../../components/Faq.astro';
import WorkflowTimeline from '../../components/WorkflowTimeline.astro';
import { priceLabel } from '../../lib/format';
import { phaseById } from '../../lib/loop';
import { statusLabel } from '../../lib/status';
import { fieldAnchor, fieldRefsIn, fieldUsage, metricAnchor, objectLabel, segmentHref, segmentLabel, sortWorkflows, stepRefs, whenLabel, withLabels } from '../../lib/library';
import OutcomeDl from '../../components/OutcomeDl.astro';
import RouteCta from '../../components/RouteCta.astro';
import { getSectors } from '../../lib/sectors';
import { library, site } from '../../lib/site';
import { platforms } from '../../lib/platforms';
import { trackHref, trackOf } from '../../lib/tracks';
import { assertLibrary } from '../../lib/library-check';

export async function getStaticPaths() {
  await assertLibrary();
  const all = sortWorkflows(await getCollection('workflows'));
  return all.map((workflow, i) => ({
    params: { slug: workflow.id },
    props: { workflow, prev: all[i - 1], following: all[i + 1] },
  }));
}

const { workflow, prev, following } = Astro.props;
const { code, name, version, phase, summary, outcome, updated, trigger, goal, enroll, steps, exit, handover, segments, needs_blueprint, owner, priority, status, seo, why, example, mistakes, faq } = workflow.data;
const st = statusLabel[status];
const loopPhase = phaseById(phase);
const next = workflow.data.next ? await getEntry(workflow.data.next) : undefined;
const fields = await getEntries(workflow.data.fields);
const metrics = await getEntries(workflow.data.metrics);
const allFields = await getCollection('fields');
const labels = new Map(allFields.map((f) => [f.id, f.data.label]));
const fieldInfo = new Map(allFields.map((f) => [f.id, { label: f.data.label, type: f.data.type, example: f.data.example, says: f.data.says }]));
const counted = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const countOf = (a: string) => steps.filter((s) => s.action === a).length;
const stepCount = [
  countOf('e-mail') && counted(countOf('e-mail'), 'e-mail', 'e-mails'),
  countOf('taak') && counted(countOf('taak'), 'taak', 'taken'),
  countOf('melding') && counted(countOf('melding'), 'melding', 'meldingen'),
  countOf('systeem') && counted(countOf('systeem'), 'systeemstap', 'systeemstappen'),
].filter(Boolean).join(', ');
const say = (text: string) => stepRefs(withLabels(text, labels));
const usage = fieldUsage(workflow);
const startFields = new Set([enroll.at, enroll.on, ...enroll.if, ...enroll.not_if].flatMap(fieldRefsIn));
const updatedLabel = updated?.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const startBlock = enroll.at ? 'Start op een datum (at)' : 'Start bij een wijziging (on)';
const platformNotes = Object.values(platforms).map((p) => ({
  name: p.name,
  object: p.objects[enroll.object],
  start: p.blocks.find(([term]) => term === startBlock)?.[1],
}));
const flow = await getEntry('services', 'flow');
if (!flow) throw new Error('Missing services/flow.json');

const metricTypes = ['volume', 'conversie', 'doorlooptijd', 'omzet'] as const;
const typeLabel = { volume: 'Volume', conversie: 'Conversie', doorlooptijd: 'Doorlooptijd', omzet: 'Omzet' };

const pageUrl = new URL(`/workflows/${workflow.id}/`, Astro.site).href;
const track = trackOf(workflow.data.track);
const crumbs: [string, string][] = [['/', 'Home'], ['/workflows/', 'Workflows'], [trackHref(track), track.name], [`/workflows/${workflow.id}/`, name]];
// What each sector calls this workflow's trigger, from the sector files.
const sectorTerms = (await getSectors()).filter((s) => s.data.terms[workflow.id]).map((s) => ({ slug: s.data.slug, name: s.data.name, term: s.data.terms[workflow.id] }));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map(([href, label], i) => ({ '@type': 'ListItem', position: i + 1, name: label, item: new URL(href, Astro.site).href })),
  },
  ...(faq.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      }]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${name}: workflow in HubSpot of ActiveCampaign`,
    description: summary,
    url: pageUrl,
    provider: { '@type': 'ProfessionalService', name: 'Workflow Factory' },
    areaServed: 'NL',
    offers: flow.data.prices.map((p) => ({
      '@type': 'Offer',
      priceCurrency: 'EUR',
      priceSpecification: { '@type': 'PriceSpecification', minPrice: p.from, maxPrice: p.to ?? p.from, priceCurrency: 'EUR' },
    })),
  },
];
---
<Base title={`${seo.title} | Workflow Factory`} description={seo.description} path={`/workflows/${workflow.id}/`} jsonLd={jsonLd}>
  <PageHero crumbs={crumbs} kicker={`${code} · ${track.name} · Fase ${loopPhase.name.toLowerCase()}`} title={name} intro={summary}>
    <Fragment slot="meta">
      <span class={`rounded-md border px-2 py-0.5 text-xs font-medium ${st.style}`} title={st.text}>{st.label}</span>
      {!needs_blueprint && <span class="rounded-md bg-mint px-2 py-0.5 text-xs font-semibold text-forest" title="Hoeft niet te wachten op je positionering">Kan meteen</span>}
      <span>Door {site.founder}{updatedLabel && `, bijgewerkt op ${updatedLabel}`}</span>
    </Fragment>
    <Button href="/contact/">Laat hem bouwen</Button>
    <Button href="/opvolgscan/" variant="ghost-light">Doe eerst de scan</Button>
    <Button href="#stappen" variant="ghost-light" arrow={false}>Bekijk de flow ↓</Button>
    <p slot="after" class="text-sm text-muted">{st.label}: {st.text.charAt(0).toLowerCase()}{st.text.slice(1)}</p>
  </PageHero>

  <div class="mx-auto max-w-6xl px-4 pb-16 md:px-8 md:pb-20"><OutcomeDl outcome={outcome} /></div>

  <Section id="stappen" n="01" label="De flow" title={`Zo loopt ${name.toLowerCase()}`}>
    <dl class="grid grid-cols-2 gap-x-8 gap-y-6 border-b border-fg/10 pb-8 md:grid-cols-4">
      <div><dt class="text-[13px] text-muted">Stappen</dt><dd class="mt-1">{stepCount}</dd></div>
      <div><dt class="text-[13px] text-muted">Eigenaar</dt><dd class="mt-1 capitalize">{owner}</dd></div>
      <div><dt class="text-[13px] text-muted">Nodig in je CRM</dt><dd class="mt-1"><a href="#velden" class="hover:text-accent hover:underline">{fields.length} velden, {startFields.size} om te starten</a></dd></div>
      <div><dt class="text-[13px] text-muted">Werkt in</dt><dd class="mt-1"><a href="/workflows/hubspot/" class="hover:text-accent hover:underline">HubSpot</a>, <a href="/workflows/activecampaign/" class="hover:text-accent hover:underline">ActiveCampaign</a></dd></div>
    </dl>
    <div class="mt-10">
      <WorkflowTimeline workflow={workflow} fields={fieldInfo} next={next} />
    </div>
  </Section>

  <Section id="waarom" n="02" label="Waarom" title={`Waarom ${name.toLowerCase()}?`}>
    <div class="grid gap-10 md:grid-cols-12">
      <div class="max-w-prose space-y-5 text-lg md:col-span-7">
        <p>{why}</p>
        <p class="text-fg/75"><span class="font-medium text-fg">Waar het lekt in de fase {loopPhase.name.toLowerCase()}:</span> {loopPhase.leak}</p>
      </div>
      {example && (
        <aside class="self-start rounded-xl border border-accent/30 bg-accent/5 p-8 md:col-span-5">
          <p class="text-[13px] font-medium text-accent">Rekenvoorbeeld</p>
          <p class="mt-4 text-lg leading-snug">{example}</p>
        </aside>
      )}
    </div>
  </Section>

  <Section id="velden" n="03" label="Data" title="Wat je in je CRM nodig hebt" intro="Per veld waar deze workflow het voor gebruikt, waar het vandaan komt en hoe je controleert dat het klopt. Ontbreekt een verplicht veld, dan start de workflow niet, of op het verkeerde moment.">
    <p class="flex flex-wrap items-center gap-2 text-sm">
      <span class="mr-1 text-muted">Minimaal nodig om te starten:</span>
      {fields.filter((f) => startFields.has(f.id)).map((f) => <a href={`#${fieldAnchor(f.id)}`} class="rounded-full border border-accent/40 px-3 py-1 text-accent hover:bg-accent/5">{f.data.label}</a>)}
    </p>
    <div class="mt-6 grid gap-3 text-[15px] md:grid-cols-2">
      {platformNotes.map((p) => (
        <p><span class="font-medium">In {p.name}:</span> <span class="text-fg/80">{objectLabel[enroll.object]} wordt {p.object?.charAt(0).toLowerCase()}{p.object?.slice(1)}. {p.start}</span></p>
      ))}
    </div>
    <ul class="mt-10 grid gap-4 md:grid-cols-2">
      {fields.map((f) => (
        <li id={fieldAnchor(f.id)} class="scroll-mt-24 rounded-xl border border-fg/15 p-6">
          <p class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <span class="text-lg font-medium">{f.data.label}</span>
            <span class="text-xs text-muted">{f.data.type}{f.data.required ? ', verplicht' : ', optioneel'}</span>
          </p>
          <p class="mt-1 font-mono text-xs text-muted">{f.id}</p>
          <p class="mt-4 flex flex-wrap gap-1.5">
            {(usage.get(f.id) ?? []).map((u) => <span class="rounded-md bg-mint/30 px-2 py-0.5 text-xs text-forest">{u}</span>)}
          </p>
          <dl class="mt-4 space-y-2 border-t border-fg/15 pt-4 text-sm">
            <div class="grid grid-cols-[6rem_1fr] gap-3"><dt class="text-muted">Bron</dt><dd>{f.data.source}</dd></div>
            <div class="grid grid-cols-[6rem_1fr] gap-3"><dt class="text-muted">Voorbeeld</dt><dd>{f.data.example}</dd></div>
            {f.data.options && <div class="grid grid-cols-[6rem_1fr] gap-3"><dt class="text-muted">Waarden</dt><dd>{f.data.options.join(', ')}</dd></div>}
            {f.data.check && <div class="grid grid-cols-[6rem_1fr] gap-3"><dt class="text-muted">Controle</dt><dd>{f.data.check}</dd></div>}
          </dl>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-sm"><a href="/workflows/data/" class="font-medium text-accent hover:underline">Alle velden en metingen uit de bibliotheek →</a></p>
  </Section>

  <Section id="dashboard" n="04" label="Dashboard" title="Wat je dashboard laat zien" intro="Elke meting is één keer gedefinieerd, zodat je workflows met elkaar kunt vergelijken.">
    <ul class="grid gap-4 md:grid-cols-2">
      {metricTypes.flatMap((t) => metrics.filter((m) => m.data.type === t)).map((m) => (
        <li class="rounded-xl border border-fg/15 p-8">
          <p class="text-[13px] font-medium text-muted">{typeLabel[m.data.type]} · {m.data.unit}</p>
          <p class="mt-6 text-2xl leading-snug"><a href={`/workflows/data/#${metricAnchor(m.id)}`} class="hover:text-accent hover:underline">{m.data.label}</a></p>
          {m.data.type === 'conversie'
            ? <p class="mt-3 text-fg/80">{m.data.numerator}, gedeeld door {m.data.denominator}.</p>
            : <p class="mt-3 text-fg/80">{m.data.definition}</p>}
          <p class="mt-3 text-sm text-fg/70">Gemeten {m.data.period}.</p>
        </li>
      ))}
    </ul>
  </Section>

  {mistakes.length > 0 && (
    <Section id="fouten" n="05" label="Fouten" title="Veelgemaakte fouten">
      <ol class="max-w-3xl border-b border-fg/15">
        {mistakes.map((m, i) => (
          <li class="grid grid-cols-[3rem_1fr] border-t border-fg/15 py-5 text-lg"><span class="text-muted">0{i + 1}</span>{m}</li>
        ))}
      </ol>
    </Section>
  )}

  {faq.length > 0 && (
    <Section id="vragen" n="06" label="Vragen" title={`Vragen over ${name.toLowerCase()}`}>
      <div class="max-w-3xl"><Faq items={faq.map((f) => ({ question: f.q, answer: f.a }))} /></div>
    </Section>
  )}

  <Section id="past" n="07" label="Past bij" title={sectorTerms.length > 0 ? 'Zo heet het in jouw branche' : 'Voor welke branches'}>
    {sectorTerms.length > 0 && (
      <>
        <p class="max-w-2xl text-fg/80">Zo start de workflow: {trigger} In jouw branche heet dat anders. De workflow blijft dezelfde.</p>
        <dl class="mt-8 border-b border-fg/15">
          {sectorTerms.map((t) => (
            <div class="grid gap-1 border-t border-fg/15 py-4 md:grid-cols-[18rem_1fr] md:gap-8">
              <dt class="text-fg/70"><a href={`/${t.slug}/`} class="hover:text-accent hover:underline">{t.name}</a></dt>
              <dd class="font-medium">{t.term}</dd>
            </div>
          ))}
        </dl>
      </>
    )}
    <ul class="mt-8 flex flex-wrap gap-3">
      {segments.map((s) => (
        <li><a href={segmentHref[s]} class="inline-block rounded-lg border border-fg/30 px-4 py-2 hover:border-accent hover:text-accent">{segmentLabel[s]} →</a></li>
      ))}
    </ul>
    <p class="mt-8 text-fg/80">Werkt in HubSpot of ActiveCampaign. Geen Salesforce.</p>
  </Section>

  <Section id="prijs" n="08" label="Prijs" tone="dark" title={`${name}, ingericht in ${flow.data.duration.replace(' per workflow', '')}`}>
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        {flow.data.prices.map((p) => <p class="font-display text-5xl tracking-[-0.03em] md:text-6xl">{priceLabel(p)}</p>)}
        <p class="mt-3 text-fg/80">Per workflow. Voorstel. {flow.data.priceNote}</p>
      </div>
      <Button href="/contact/">Plan een kennismaking</Button>
    </div>
  </Section>

  <RouteCta />

  <p class="mx-auto max-w-6xl px-4 pb-8 pt-12 text-sm text-fg/70 md:px-8">
    {code} versie {version}. {library.emailsPublic ? 'Opbouw en voorbeeldmails' : 'Opbouw'} vrij te gebruiken met naamsvermelding, onder <a href="https://creativecommons.org/licenses/by/4.0/deed.nl" class="underline underline-offset-4 hover:text-accent">CC BY 4.0</a>.
  </p>
  <nav aria-label="Andere workflows" class="mx-auto grid max-w-6xl gap-4 px-4 pb-24 md:grid-cols-2 md:px-8">
    {prev ? (
      <a href={`/workflows/${prev.id}/`} class="rounded-xl border border-fg/15 p-6 hover:border-accent/60">
        <span class="text-[13px] text-muted">← Vorige</span>
        <span class="mt-2 block text-2xl">{prev.data.name}</span>
      </a>
    ) : <span />}
    {following && (
      <a href={`/workflows/${following.id}/`} class="rounded-xl border border-fg/15 p-6 text-right hover:border-accent/60">
        <span class="text-[13px] text-muted">Volgende →</span>
        <span class="mt-2 block text-2xl">{following.data.name}</span>
      </a>
    )}
  </nav>
</Base>
