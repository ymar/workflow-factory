---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import WorkflowCard from '../../components/WorkflowCard.astro';
import LoopIndex from '../../components/LoopIndex.astro';
import { priceLabel } from '../../lib/format';
import { statusLabel } from '../../lib/status';
import { assertLibrary } from '../../lib/library-check';
import { sortWorkflows } from '../../lib/library';
import { tracks, trackHref } from '../../lib/tracks';
import { phases } from '../../lib/loop';
import Newsletter from '../../components/Newsletter.astro';
import { library } from '../../lib/site';

await assertLibrary();

const workflows = sortWorkflows(await getCollection('workflows'));
const [fieldCount, metricCount] = [(await getCollection('fields')).length, (await getCollection('metrics')).length];
const withMails = workflows.filter((w) => w.data.steps.some((s) => s.email)).length;
const flow = await getEntry('services', 'flow');
if (!flow) throw new Error('Missing services/flow.json');

const title = 'Marketing automation voorbeelden | Workflow Factory';
const description = `Voor B2B-bedrijven waar opvolging blijft liggen: ${workflows.length} workflows voor meer aanvragen, sneller opvolgen en klanten houden. Voor HubSpot en ActiveCampaign.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Workflowbibliotheek',
    itemListElement: workflows.map((j, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: j.data.name,
      url: new URL(`/workflows/${j.id}/`, Astro.site).href,
    })),
  },
];
---
<Base title={title} description={description} path="/workflows/" jsonLd={jsonLd}>
  <PageHero
    icon="flow"
    crumbs={[['/', 'Home'], ['/workflows/', 'Workflows']]}
    kicker="Open workflowbibliotheek"
    title="Opvolging die vanzelf loopt,"
    accent={`${workflows.length} workflows klaar om te bouwen.`}
    intro="B2B-bedrijven verliezen omzet aan aanvragen, offertes en facturen die blijven liggen. Elke workflow start op een datum of gebeurtenis die je al registreert en zet de opvolging in gang. Zodat je meer verlengt, wint en betaald krijgt. Kies per uitkomst."
  >
    <Button href="/opvolgscan/">Doe de opvolgscan</Button>
    <Button href="/workflows/data/" variant="ghost-dark">Velden en metingen</Button>
  </PageHero>


  <section aria-label="Workflows per uitkomst">
    <div class="mx-auto max-w-6xl px-4 md:px-8">
      {tracks.map((t) => (
        <section id={t.slug} aria-labelledby={`${t.slug}-title`} class="scroll-mt-20 border-t border-fg/10 py-14 md:py-20">
          <div class="grid gap-10 md:grid-cols-12">
            <div class="md:col-span-4">
              <p class="text-[13px] font-medium text-accent">Uitkomst</p>
              <h2 id={`${t.slug}-title`} class="mt-2 text-[1.75rem] md:text-[2.25rem]"><a href={trackHref(t)} class="hover:text-accent">{t.name}</a></h2>
              <p class="mt-4 max-w-sm text-fg/80">{t.promise}</p>
              <a href={trackHref(t)} class="mt-6 inline-flex items-center gap-2 text-[15px] font-medium text-accent hover:underline">Naar de uitkomst <span aria-hidden="true">→</span></a>
            </div>
            <ul class="grid content-start gap-4 md:col-span-8 lg:grid-cols-2">
              {workflows.filter((w) => w.data.track === t.id).map((w) => (
                <li><WorkflowCard workflow={w} showPhase /></li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>
  </section>

  <Section id="loop" label="Het model" title="Een loop, geen funnel" intro="Onder de drie uitkomsten zitten zes fasen, gezien vanaf de klant. In elke fase kan omzet weglekken. Klik op een fase voor de workflows die daar horen.">
    <LoopIndex workflows={workflows} />
    <div class="mt-16 grid gap-x-10 gap-y-12 md:grid-cols-2">
      {phases.map((p) => (
        <div id={`fase-${p.id}`} class="scroll-mt-24">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6">
            <h3 class="text-2xl">Fase {p.name.toLowerCase()}</h3>
            <p class="text-sm text-muted">{p.revenue}</p>
          </div>
          <p class="mt-2 text-[15px] text-fg/75"><span class="text-fg">Waar het lekt:</span> {p.leak}</p>
          <ul class="mt-4 border-b border-fg/15">
            {workflows.filter((w) => w.data.phase === p.id).map((w) => (
              <li class="border-t border-fg/15"><a href={`/workflows/${w.id}/`} class="group flex items-center justify-between gap-4 py-3 hover:text-accent">{w.data.name}<span aria-hidden="true" class="text-muted group-hover:text-accent">→</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <Section id="open" label="Open bibliotheek" title={library.emailsPublic ? 'De opbouw en de mails zijn open.' : 'De opbouw is open. De woorden niet.'} intro="Gebruik de workflows gerust, ook als je mij niet inhuurt. Vermeld alleen waar ze vandaan komen.">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-fg/15 p-8">
        <p class="text-[13px] font-medium text-accent">Open</p>
        <ul class="mt-6 space-y-2 text-lg">
          <li>De trigger en het doel</li>
          <li>De stappen en de timing</li>
          <li>De overdrachtsregel</li>
          <li>Wat het dashboard meet</li>
          <li>De velden die je in je CRM nodig hebt</li>
          {library.emailsPublic && <li>Voorbeeldmails per stap <span class="text-base text-muted">(klaar voor {withMails} van {workflows.length} workflows)</span></li>}
        </ul>
        <a href="/workflows/data/" class="mt-6 inline-flex items-center gap-2 font-medium text-accent">{fieldCount} velden en {metricCount} metingen, elk één keer gedefinieerd <span aria-hidden="true">→</span></a>
      </div>
      <div class="rounded-xl on-dark p-8">
        {library.emailsPublic ? (
          <>
            <p class="text-[13px] font-medium text-muted">Vul je zelf in</p>
            <p class="mt-6 text-2xl leading-snug">De gele plekken in de mails.</p>
            <p class="mt-3 text-fg/80">Daar komt wat alleen jij kunt zeggen: wat je voor deze klant deed, en waarom ze voor jou kiezen. Een goede flow met een vaag verhaal wordt alleen sneller vaag.</p>
          </>
        ) : (
          <>
            <p class="text-[13px] font-medium text-muted">Niet open</p>
            <p class="mt-6 text-2xl leading-snug">De teksten in de e-mails.</p>
            <p class="mt-3 text-fg/80">Die schrijven we op jouw positionering. Een goede flow met een vaag verhaal wordt alleen sneller vaag.</p>
          </>
        )}
        <a href="/blueprint/" class="mt-6 inline-flex items-center gap-2 font-medium text-accent">Over Blueprint <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h3 class="text-2xl">Hoe ver is elke workflow?</h3>
        <ul class="mt-6 space-y-4">
          {Object.values(statusLabel).map((st) => (
            <li class="flex items-start gap-3">
              <span class={`mt-0.5 shrink-0 rounded-md border px-2 py-0.5 text-xs font-medium ${st.style}`}>{st.label}</span>
              <span class="text-fg/80">{st.text}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="space-y-4 text-fg/80">
        <h3 class="text-2xl text-fg">Zo breidt de bibliotheek uit</h3>
        <p>Elke pilotklant test één workflow. Daarna gaat die van concept naar getest, en met cijfers naar bewezen. We beginnen bij installatie en onderhoud en bij machinebouw, en maken die eerst compleet.</p>
        <p>De opbouw is vrij te gebruiken met naamsvermelding, onder <a href="https://creativecommons.org/licenses/by/4.0/deed.nl" class="text-accent underline underline-offset-4">CC BY 4.0</a>.</p>
      </div>
    </div>
  </Section>

  <Newsletter />

  <Section id="maatwerk" label="Maatwerk" title="Staat jouw workflow er niet bij?">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-xl on-dark p-8">
        <p class="text-[13px] font-medium text-muted">Waar je begint</p>
        <p class="mt-6 text-2xl leading-snug">Aanvraag-, offerte- en factuuropvolging kunnen meteen. Die hoeven niet te wachten op je positionering.</p>
        <p class="mt-3 text-fg/80">Voor de andere workflows geldt: eerst Blueprint.</p>
        <a href="/blueprint/" class="mt-8 inline-flex items-center gap-2 font-medium text-accent">Over Blueprint <span aria-hidden="true">→</span></a>
      </div>
      <div class="rounded-xl border border-dashed border-fg/30 p-8">
        <p class="text-[13px] font-medium text-muted">Maatwerk</p>
        <p class="mt-6 text-2xl leading-snug">Past je proces er niet in? Dan schrijven we eerst een flowspecificatie voor jouw situatie.</p>
        <a href="/contact/" class="mt-8 inline-flex items-center gap-2 font-medium text-accent">Plan een kennismaking <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </Section>

  <Section id="prijs" label="Prijs" tone="dark" title="Eén prijs per workflow">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        {flow.data.prices.map((p) => <p class="font-display text-5xl tracking-[-0.03em] md:text-6xl">{priceLabel(p)}</p>)}
        <p class="mt-4 text-fg/80">{flow.data.prices[0]?.label}, {flow.data.duration}. Voorstel.</p>
        {flow.data.priceNote && <p class="mt-2 text-fg/80">{flow.data.priceNote} Ook dit is een voorstel.</p>}
      </div>
      <div class="space-y-4 text-fg/80">
        <p>Elke workflow levert hetzelfde op: een flowspecificatie van één pagina, de flow live met e-mails, verkooptaken en overdrachtsregels, en een dashboard met volume, conversie en doorlooptijd per stap.</p>
        <div class="pt-4"><Button href="/contact/">Plan een kennismaking</Button></div>
      </div>
    </div>
  </Section>
</Base>
