---
import ServicePage from '../../components/ServicePage.astro';
---
<ServicePage
  id="blueprint"
  kicker="Startpunt"
  headline="Blueprint. Vind de positie"
  accent="die niemand kan kopiëren."
  title="Blueprint · Positionering en homepage in 2 weken | neon"
  description="Blueprint: je positionering vastgelegd en op je homepage gezet. We vinden wat geen concurrent kan kopiëren. 2 weken."
  signals={[
    'Je concurreert vooral op prijs.',
    'Je website klinkt als die van de concurrent.',
    'Je kunt niet in één zin zeggen waarom klanten voor jou kiezen.',
    'Campagnes leveren weinig reacties op.',
  ]}
>
  <div slot="after-deliverables" class="mt-16 grid gap-8 md:grid-cols-[16rem_1fr]">
    <h3 class="text-3xl">De vier checks</h3>
    <div>
      <ol class="border-b border-paper/15">
        {['Klopt het?', 'Maakt het verschil voor de koper?', 'Kan een concurrent het zeggen?', 'Wint het ook de tweede order?'].map((q, i) => (
          <li class="grid grid-cols-[3rem_1fr] border-t border-paper/15 py-4 text-lg"><span class="text-paper/70">0{i + 1}</span>{q}</li>
        ))}
      </ol>
      <p class="mt-6 text-paper/80">Ongeveer 6 uur van jouw tijd. Het schrijven doen wij.</p>
    </div>
  </div>
</ServicePage>
