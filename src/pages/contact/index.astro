---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import Placeholder from '../../components/Placeholder.astro';
import { site } from '../../lib/site';
---
<Base
  title="Contact · Plan 30 minuten | Workflow Factory"
  description="Plan 30 minuten voor de opvolgscan of een kennismaking. Je hoort waar je opvolging blijft liggen, welke workflow past en wat die kost."
  path="/contact/"
>
  <PageHero kicker="Contact" title="Plan 30 minuten. Ik zeg je eerlijk of je klaar bent voor campagnes, of eerst" accent="je positionering moet fixen." />
  <div>
    <div class="mx-auto max-w-6xl px-4 pb-24 md:px-8 md:pb-32">
      <div class="grid gap-8 border-t border-fg/15 pt-8 md:grid-cols-3">
        <div>
          <p class="text-[13px] text-muted">Kennismaking</p>
          <div class="mt-4">{site.bookingUrl ? <Button href={site.bookingUrl}>Kies een moment</Button> : <Placeholder label="Boekingslink volgt" />}</div>
        </div>
        <div>
          <p class="text-[13px] text-muted">E-mail</p>
          <p class="mt-4 text-lg">{site.email ? <a class="underline underline-offset-4 hover:text-accent" href={`mailto:${site.email}?subject=Kennismaking`}>{site.email}</a> : <Placeholder label="e-mailadres" />}</p>
        </div>
        <div>
          <p class="text-[13px] text-muted">Beschikbaarheid</p>
          <p class="mt-4 text-lg">{site.availability || <Placeholder label="bijvoorbeeld: eerste sprint vanaf januari" />}</p>
        </div>
      </div>
    </div>
  </div>

  <Section id="daarna" n="01" label="Daarna" title="Dit gebeurt er na je aanvraag">
    <ol class="border-b border-fg/15">
      <li class="grid grid-cols-[3rem_1fr] border-t border-fg/15 py-6 text-lg md:text-2xl"><span class="text-fg/70">01</span><span>Je kiest een moment of mailt. Je hoort binnen <Placeholder label="reactietijd" /> terug.</span></li>
      <li class="grid grid-cols-[3rem_1fr] border-t border-fg/15 py-6 text-lg md:text-2xl"><span class="text-fg/70">02</span><span>We lopen je cijfers door in 30 minuten.</span></li>
      <li class="grid grid-cols-[3rem_1fr] border-t border-fg/15 py-6 text-lg md:text-2xl"><span class="text-fg/70">03</span><span>Je krijgt de pagina met de drie lekken. Past het niet bij je, dan zeggen we dat.</span></li>
    </ol>
  </Section>

  <Section id="gesprek" n="02" label="Het gesprek" title="Na 30 minuten weet je dit">
    <ol class="border-b border-fg/15">
      {[
        'Of je klaar bent voor campagnes, of eerst je positionering moet fixen.',
        'Welk product past. Of dat er geen past.',
        'Wat het kost en wanneer we kunnen beginnen.',
      ].map((s, i) => (
        <li class="grid grid-cols-[3rem_1fr] border-t border-fg/15 py-6 text-lg md:text-2xl"><span class="text-fg/70">0{i + 1}</span>{s}</li>
      ))}
    </ol>
    <p class="mt-10 text-fg/80">Kom je voor de <a href="/opvolgscan/" class="text-accent underline underline-offset-4">opvolgscan</a>? Neem dan je cijfers mee: aanvragen en offertes per maand, het gemiddelde bedrag en het aantal contracten.</p>
    <p class="mt-4 text-fg/80">Neem je homepage mee en een recente offerte die je verloor. Geen verkooppraatje: als het niet past, zeg ik dat.</p>
  </Section>
</Base>
