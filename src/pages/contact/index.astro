---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import Placeholder from '../../components/Placeholder.astro';
import { site } from '../../lib/site';
---
<Base
  title="Contact · Plan 30 minuten | neon"
  description="Plan 30 minuten. Ik zeg je eerlijk of je klaar bent voor campagnes, of eerst je verhaal moet fixen."
  path="/contact/"
>
  <PageHero kicker="Contact" title="Plan 30 minuten. Ik zeg je eerlijk of je klaar bent voor campagnes, of eerst" accent="je verhaal moet fixen." />
  <div>
    <div class="mx-auto max-w-6xl px-4 pb-24 md:px-8 md:pb-32">
      <div class="grid gap-8 border-t border-paper/15 pt-8 md:grid-cols-3">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-sage">Kennismaking</p>
          <div class="mt-4">{site.bookingUrl ? <Button href={site.bookingUrl}>Kies een moment</Button> : <Placeholder label="Boekingslink volgt" />}</div>
        </div>
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-sage">E-mail</p>
          <p class="mt-4 text-lg">{site.email ? <a class="underline underline-offset-4 hover:text-mint" href={`mailto:${site.email}?subject=Kennismaking`}>{site.email}</a> : <Placeholder label="e-mailadres" />}</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-sage">Beschikbaarheid</p>
          <p class="mt-4 text-lg">{site.availability || <Placeholder label="bijvoorbeeld: eerste sprint vanaf januari" />}</p>
        </div>
      </div>
    </div>
  </div>

  <Section id="gesprek" n="01" label="Het gesprek" title="Wat er in 30 minuten gebeurt">
    <ol class="border-b border-paper/15">
      {[
        'Je vertelt wat je verkoopt, aan wie, en wat er nu misgaat.',
        'Ik kijk mee naar je homepage en je opvolging.',
        'Je hoort van mij of je klaar bent voor campagnes. Zo niet, dan zeg ik wat eerst moet.',
      ].map((s, i) => (
        <li class="grid grid-cols-[3rem_1fr] border-t border-paper/15 py-6 text-lg md:text-2xl"><span class="text-paper/70">0{i + 1}</span>{s}</li>
      ))}
    </ol>
    <p class="mt-10 text-paper/80">Geen verkooppraatje. Als het niet past, zeg ik dat.</p>
  </Section>
</Base>
