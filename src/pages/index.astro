---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import SectorRow from '../components/SectorRow.astro';
import StepsOffer from '../components/StepsOffer.astro';
import Newsletter from '../components/Newsletter.astro';
import Placeholder from '../components/Placeholder.astro';
import Faq from '../components/Faq.astro';
import TimelineMini from '../components/TimelineMini.astro';
import { tracks, trackHref } from '../lib/tracks';
import { sortWorkflows } from '../lib/library';

const workflows = sortWorkflows(await getCollection('workflows'));
const allFields = await getCollection('fields');
const [fieldCount, metricCount] = [allFields.length, (await getCollection('metrics')).length];
const fieldInfo = new Map(allFields.map((f) => [f.id, { label: f.data.label, type: f.data.type, example: f.data.example, says: f.data.says }]));
const example = workflows.find((w) => w.id === 'contractverlenging');
const faq = (await getCollection('faq')).filter((f) => f.data.page === 'home').sort((a, b) => a.data.order - b.data.order);
const n = workflows.length;

const title = 'Meer klanten voor B2B, zonder harder te jagen | Workflow Factory';
const description = 'Voor B2B-bedrijven die verdienen aan contracten, service en herhaalorders: aanvragen, offertes en facturen op tijd opgevolgd, en klanten die terugkomen.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Workflow Factory',
    url: new URL('/', Astro.site).href,
    inLanguage: 'nl-NL',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Workflow Factory',
    url: new URL('/', Astro.site).href,
    description,
    areaServed: 'NL',
    knowsAbout: ['Marketing automation', 'HubSpot', 'ActiveCampaign', 'CRM', 'Revenue Architecture'],
    audience: { '@type': 'BusinessAudience', name: 'B2B-bedrijven die verdienen aan contracten, service en herhaalorders' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Workflowbibliotheek',
    itemListElement: workflows.map((w, i) => ({ '@type': 'ListItem', position: i + 1, name: w.data.name, url: new URL(`/workflows/${w.id}/`, Astro.site).href })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.data.question, acceptedAnswer: { '@type': 'Answer', text: f.data.answer } })),
  },
];

---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hero-glow">
    <div class="mx-auto max-w-6xl px-4 pb-16 pt-12 md:px-8 md:pb-20 md:pt-20">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7">
          <p class="text-[13px] font-medium text-muted">Voor B2B-bedrijven die verdienen aan contracten, service en herhaalorders</p>
          <h1 class="mt-5 text-[2.5rem] leading-[1.02] tracking-[-0.035em] md:text-6xl">
            Meer klanten, <span class="neon-text">zonder harder te jagen.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg text-fg/80 md:text-xl">
            Aanvragen, offertes en facturen blijven liggen tot iemand eraan denkt. Met deze workflows loopt je opvolging vanzelf: elke aanvraag binnen een werkdag gebeld, elke offerte opgevolgd tot ja of nee, elke factuur op tijd betaald. En klanten die je al hebt, denken aan jou als het weer nodig is.
          </p>
          <p class="mt-5 max-w-xl border-l-2 border-accent/50 pl-4 text-[15px] text-fg/75"><span class="font-medium text-fg">Voorbeeld.</span> Stel: 400 contracten van €1.200. Elk procentpunt dat je meer verlengt, is €4.800 per jaar.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href="/opvolgscan/">Doe de opvolgscan</Button>
            <Button href="/workflows/" variant="ghost-dark">Bekijk de workflows</Button>
          </div>
        </div>
        {example && <div class="lg:col-span-5"><TimelineMini workflow={example} fields={fieldInfo} /></div>}
      </div>
      <ul class="mt-16 grid gap-3 border-t border-fg/10 pt-5 text-sm text-muted sm:grid-cols-4">
        <li><span class="font-medium text-fg">{n}</span> workflows</li>
        <li><span class="font-medium text-fg">{fieldCount}</span> CRM-velden</li>
        <li><span class="font-medium text-fg">{metricCount}</span> metingen</li>
        <li>Open onder CC BY 4.0</li>
      </ul>
    </div>
  </section>

  <Section id="voor-wie" label="Voor wie" title="Jouw branche, in jouw woorden" intro="Dezelfde workflows, vier woordenlijsten. Een oplevering, een inbedrijfstelling, een livegang of een aflevering: de opvolging start op de datum die jij al kent.">
    <SectorRow />
    <p class="mt-6 text-sm"><a href="/branches/" class="font-medium text-accent hover:underline">Alle branches →</a></p>
  </Section>

  <Section id="uitkomsten" label="Wat wil je bereiken?" title="Drie uitkomsten" intro="Elke workflow hoort bij één van deze drie. Kies wat je nu het meest mist.">
    <ul class="grid gap-4 lg:grid-cols-3">
      {tracks.map((t) => {
        const list = workflows.filter((w) => w.data.track === t.id);
        return (
          <li class="flex flex-col rounded-xl border border-fg/15 bg-white p-6 md:p-8">
            <h3 class="text-2xl"><a href={trackHref(t)} class="hover:text-accent">{t.name}</a></h3>
            <p class="mt-3 text-fg/80">{t.promise}</p>
            <ul class="mt-6 border-t border-fg/10">
              {list.map((w) => (
                <li class="border-b border-fg/10"><a href={`/workflows/${w.id}/`} class="group flex items-baseline justify-between gap-4 py-2.5 hover:text-accent"><span>{w.data.name}</span><span aria-hidden="true" class="text-muted transition-transform group-hover:text-accent motion-safe:group-hover:translate-x-0.5">→</span></a></li>
              ))}
            </ul>
            <a href={trackHref(t)} class="mt-6 inline-flex items-center gap-2 text-[15px] font-medium text-accent hover:underline">Alles over {t.name.toLowerCase()} <span aria-hidden="true">→</span></a>
          </li>
        );
      })}
    </ul>
  </Section>

  <Section id="diensten" label="Zo werkt het" title="Drie stappen. Je begint met de scan." intro="Je betaalt niet per uur. Alle prijzen zijn voorstellen.">
    <StepsOffer />
    <p class="mt-8 text-sm text-fg/75">Is je verhaal of je pagina de rem? Dan zijn er <a href="/diensten/#extra" class="text-accent underline underline-offset-4">Blueprint en Build</a>.</p>
  </Section>

  <Section id="resultaten" label="Resultaten" title="Wat het opleverde" intro="Elke workflow is nu een concept. Zodra een pilot cijfers heeft, komen ze hier te staan. Tot dan staat er niets.">
    <ul class="grid gap-4 md:grid-cols-3">
      {[1, 2, 3].map((i) => (
        <li class="rounded-xl border border-dashed border-fg/30 p-8">
          <p class="text-[13px] font-medium text-muted">Case {i}</p>
          <p class="mt-6 text-lg"><Placeholder label={`bedrijf, workflow en gemeten cijfers van pilot ${i}`} /></p>
        </li>
      ))}
    </ul>
  </Section>

  <Newsletter />

  <Section id="faq" label="Vragen" title="Veelgestelde vragen">
    <Faq items={faq.map((f) => ({ question: f.data.question, answer: f.data.answer }))} />
  </Section>

  <section class="on-dark" aria-labelledby="cta">
    <div class="mx-auto max-w-6xl px-4 py-24 md:px-8 md:py-36">
      <h2 id="cta" class="max-w-5xl text-4xl leading-[1.05] tracking-[-0.02em] md:text-6xl">
        Begin met de scan. In 30 minuten zie je <span class="neon-text">waar je opvolging blijft liggen</span>, en wat dat per jaar kost.
      </h2>
      <div class="mt-12 flex flex-wrap gap-3">
        <Button href="/opvolgscan/">Doe de opvolgscan</Button>
        <Button href="/contact/" variant="ghost-dark">Plan een kennismaking</Button>
      </div>
    </div>
  </section>
</Base>
