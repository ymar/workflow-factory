---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import WorkflowCard from '../components/WorkflowCard.astro';
import LoopIndex from '../components/LoopIndex.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Faq from '../components/Faq.astro';
import TimelineMini from '../components/TimelineMini.astro';
import { sortWorkflows } from '../lib/library';
import { library } from '../lib/site';

const workflows = sortWorkflows(await getCollection('workflows'));
const allFields = await getCollection('fields');
const [fieldCount, metricCount] = [allFields.length, (await getCollection('metrics')).length];
const fieldInfo = new Map(allFields.map((f) => [f.id, { label: f.data.label, type: f.data.type, example: f.data.example, says: f.data.says }]));
const example = workflows.find((w) => w.id === 'contractverlenging');
const faq = (await getCollection('faq')).filter((f) => f.data.page === 'home').sort((a, b) => a.data.order - b.data.order);
const n = workflows.length;

const title = 'Marketing automation workflows voor B2B | Workflow Factory';
const description = `${n} kant-en-klare workflows voor HubSpot en ActiveCampaign, van aanvraagopvolging tot contractverlenging. Met triggers, stappen, CRM-velden en metingen.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Workflow Factory',
    url: new URL('/', Astro.site).href,
    inLanguage: 'nl-NL',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Workflow Factory',
    url: new URL('/', Astro.site).href,
    description,
    areaServed: 'NL',
    knowsAbout: ['Marketing automation', 'HubSpot', 'ActiveCampaign', 'CRM', 'Revenue Architecture'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Workflowbibliotheek',
    itemListElement: workflows.map((w, i) => ({ '@type': 'ListItem', position: i + 1, name: w.data.name, url: new URL(`/workflows/${w.id}/`, Astro.site).href })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.data.question, acceptedAnswer: { '@type': 'Answer', text: f.data.answer } })),
  },
];

const contents = [
  ['Trigger en voorwaarden', 'Wanneer de workflow start, voor wie wel en voor wie niet.'],
  ['Stappen met timing', 'E-mails, taken en meldingen, met eigenaar, termijn en voorwaarden.'],
  ['Overdracht', 'Waar hij stopt, en welke workflow het overneemt.'],
  ['CRM-velden', 'Welke data je nodig hebt, met type, bron en check.'],
  ['Metingen', 'Volume, conversie en doorlooptijd, met een vaste definitie.'],
  ['Status', 'Concept, getest of bewezen. Je ziet hoe ver elke workflow is.'],
];
---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hero-glow">
    <div class="mx-auto max-w-6xl px-4 pb-16 pt-12 md:px-8 md:pb-20 md:pt-20">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7">
          <p class="text-[13px] font-medium text-muted">Open workflowbibliotheek voor HubSpot en ActiveCampaign</p>
          <h1 class="mt-5 text-[2.5rem] leading-[1.02] tracking-[-0.035em] md:text-6xl">
            Marketing automation workflows voor B2B. <span class="neon-text">Klaar om te bouwen.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg text-fg/80 md:text-xl">
            {n} workflows voor de opvolging die in de meeste bedrijven blijft liggen: aanvragen, offertes, contracten, keuringen en nabestellingen. Gratis te gebruiken, of ik bouw hem voor je.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href="/workflows/">Bekijk de workflows</Button>
            <Button href="/flow/" variant="ghost-dark">Laat er één bouwen</Button>
          </div>
        </div>
        {example && <div class="lg:col-span-5"><TimelineMini workflow={example} fields={fieldInfo} /></div>}
      </div>
      <ul class="mt-16 grid gap-3 border-t border-fg/10 pt-5 text-sm text-muted sm:grid-cols-4">
        <li><span class="font-medium text-fg">{n}</span> workflows</li>
        <li><span class="font-medium text-fg">{fieldCount}</span> CRM-velden</li>
        <li><span class="font-medium text-fg">{metricCount}</span> metingen</li>
        <li>Open onder CC BY 4.0</li>
      </ul>
    </div>
  </section>

  <Section id="fasen" n="01" label="Per fase" title="Kies waar het lekt" intro="Je klant koopt niet één keer. Zes fasen, gezien vanaf de klant, en in elke fase kan omzet weglekken. Klik op een fase voor de workflows die daar horen.">
    <LoopIndex workflows={workflows} />
  </Section>

  <Section id="workflows" n="02" label="Workflows" title={`${n} workflows, van aanvraag tot vervanging`}>
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {workflows.map((w) => <li><WorkflowCard workflow={w} showPhase /></li>)}
    </ul>
    <div class="mt-10"><Button href="/workflows/" variant="ghost-light">Naar de bibliotheek</Button></div>
  </Section>

  <Section id="opbouw" n="03" label="Wat erin zit" title="Elke workflow heeft dezelfde opbouw" intro="Zodat je ze kunt vergelijken, combineren en in elk CRM kunt bouwen.">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {contents.map(([t, d], i) => (
        <li class="rounded-xl border border-fg/15 p-8">
          <p class="text-sm text-accent">0{i + 1}</p>
          <p class="mt-6 text-2xl">{t}</p>
          <p class="mt-2 text-fg/80">{d}</p>
        </li>
      ))}
    </ul>
    <div class="on-dark mt-4 flex flex-col gap-4 rounded-xl p-8 md:flex-row md:items-center md:justify-between">
      {library.emailsPublic
        ? <p class="max-w-2xl text-lg"><span class="font-medium">Wat je zelf invult: de gele plekken in de voorbeeldmails.</span> <span class="text-fg/80">Daar zit het verschil. In Blueprint schrijven we ze op jouw positionering.</span></p>
        : <p class="max-w-2xl text-lg"><span class="font-medium">Wat er niet in zit: de teksten van de e-mails.</span> <span class="text-fg/80">Daar zit het verschil, dus die schrijven we op jouw positionering.</span></p>}
      <a href="/blueprint/" class="inline-flex shrink-0 items-center gap-2 font-medium text-accent">Over Blueprint <span aria-hidden="true">→</span></a>
    </div>
  </Section>

  <Section id="platforms" n="04" label="Per platform" title="Voor HubSpot en ActiveCampaign">
    <ul class="grid gap-4 md:grid-cols-3">
      {[
        ['/workflows/hubspot/', 'HubSpot', 'Per workflow het object, de trigger en de bouwstenen in HubSpot.'],
        ['/workflows/activecampaign/', 'ActiveCampaign', 'Dezelfde workflows, vertaald naar ActiveCampaign automations.'],
        ['/installatie-onderhoud/', 'Installatie en onderhoud', 'Van opleverdatum en MJOP naar workflows die vanzelf lopen.'],
      ].map(([href, t, d]) => (
        <li>
          <a href={href} class="group block h-full rounded-xl border border-fg/15 p-8 hover:border-accent">
            <p class="text-3xl">{t}</p>
            <p class="mt-3 text-fg/80">{d}</p>
            <span class="mt-8 inline-flex items-center gap-2 font-medium text-accent">Bekijk <span aria-hidden="true" class="transition-transform motion-safe:group-hover:translate-x-0.5">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="diensten" n="05" label="Diensten" title="Liever niet zelf bouwen?" intro="Drie diensten met een vaste prijs en een vaste oplevering. Je betaalt niet per uur. Alle prijzen zijn voorstellen.">
    <ServicesGrid highlight="flow" badge="Bouwt de workflows" />
  </Section>

  <Section id="faq" n="06" label="Vragen" title="Veelgestelde vragen">
    <Faq items={faq.map((f) => ({ question: f.data.question, answer: f.data.answer }))} />
  </Section>

  <section class="on-dark" aria-labelledby="cta">
    <div class="mx-auto max-w-6xl px-4 py-24 md:px-8 md:py-36">
      <h2 id="cta" class="max-w-5xl text-4xl leading-[1.05] tracking-[-0.02em] md:text-6xl">
        Plan 30 minuten. Ik laat je zien welke workflow bij jou het meeste oplevert, en of je eerst <span class="neon-text">je teksten</span> moet fixen.
      </h2>
      <div class="mt-12"><Button href="/contact/">Plan een kennismaking</Button></div>
    </div>
  </section>
</Base>
