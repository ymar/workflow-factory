---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import SectorRow from '../components/SectorRow.astro';
import OfferCard from '../components/OfferCard.astro';
import NotFor from '../components/NotFor.astro';
import SelfTest from '../components/SelfTest.astro';
import Newsletter from '../components/Newsletter.astro';
import Placeholder from '../components/Placeholder.astro';
import Faq from '../components/Faq.astro';
import TimelineMini from '../components/TimelineMini.astro';
import { tracks, trackHref } from '../lib/tracks';
import { sortWorkflows } from '../lib/library';

const workflows = sortWorkflows(await getCollection('workflows'));
const allFields = await getCollection('fields');
const [fieldCount, metricCount] = [allFields.length, (await getCollection('metrics')).length];
const fieldInfo = new Map(allFields.map((f) => [f.id, { label: f.data.label, type: f.data.type, example: f.data.example, says: f.data.says }]));
const example = workflows.find((w) => w.id === 'contractverlenging');
const faq = (await getCollection('faq')).filter((f) => f.data.page === 'home').sort((a, b) => a.data.order - b.data.order);
const n = workflows.length;
const flow = await getEntry('services', 'flow');
if (!flow) throw new Error('Missing services/flow.json');

const title = 'Meer onderhoudscontracten verlengd | Workflow Factory';
const description = 'Voor installatie- en onderhoudsbedrijven: contracten 90 dagen vooraf opgevolgd en offertes tot ja of nee, op de datums die je al hebt. Start met de scan.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Workflow Factory',
    url: new URL('/', Astro.site).href,
    inLanguage: 'nl-NL',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Workflow Factory',
    url: new URL('/', Astro.site).href,
    description,
    areaServed: 'NL',
    knowsAbout: ['Marketing automation', 'CRM', 'Revenue Architecture'],
    audience: { '@type': 'BusinessAudience', name: 'Installatie- en onderhoudsbedrijven met onderhoudscontracten' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Workflowbibliotheek',
    itemListElement: workflows.map((w, i) => ({ '@type': 'ListItem', position: i + 1, name: w.data.name, url: new URL(`/workflows/${w.id}/`, Astro.site).href })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.data.question, acceptedAnswer: { '@type': 'Answer', text: f.data.answer } })),
  },
];

---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hero-glow">
    <div class="mx-auto max-w-6xl px-4 pb-16 pt-12 md:px-8 md:pb-20 md:pt-20">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-7">
          <p class="text-[13px] font-medium text-muted">Voor installatie- en onderhoudsbedrijven met onderhoudscontracten</p>
          <h1 class="mt-5 text-[1.85rem] leading-[0.95] min-[400px]:text-[2.25rem] sm:text-[2.5rem] tracking-[-0.035em] md:text-[3rem] lg:text-[3.1rem]">
            Verleng meer onderhoudscontracten, <span class="neon-text">zonder erachteraan te bellen.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg text-fg/80 md:text-xl">
            Contracten lopen af en offertes liggen stil, tot iemand eraan denkt. Met twee workflows start de opvolging op de datums die je al hebt: 90 dagen voor de einddatum een voorstel met vaste belmomenten, en elke offerte opgevolgd tot ja of nee.
          </p>
          <p class="mt-5 max-w-xl border-l-2 border-accent/50 pl-4 text-[15px] text-fg/75"><span class="font-medium text-fg">Voorbeeld.</span> Stel: 400 contracten van €1.200. Elk procentpunt dat je meer verlengt, is €4.800 per jaar.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href="/opvolgscan/">Doe de opvolgscan</Button>
            <Button href="/workflows/" variant="ghost-dark">Bekijk de workflows</Button>
          </div>
        </div>
        {example && <div class="lg:col-span-5"><TimelineMini workflow={example} fields={fieldInfo} /></div>}
      </div>
      <ul class="mt-16 grid gap-3 border-t border-fg/10 pt-5 text-sm text-muted sm:grid-cols-4">
        <li><span class="font-medium text-fg">{n}</span> workflows</li>
        <li><span class="font-medium text-fg">{fieldCount}</span> CRM-velden</li>
        <li><span class="font-medium text-fg">{metricCount}</span> metingen</li>
        <li>Open onder CC BY 4.0</li>
      </ul>
    </div>
  </section>

  <section class="border-t border-fg/10" aria-label="Het aanbod">
    <div class="mx-auto max-w-6xl px-4 py-14 md:px-8 md:py-20">
      <OfferCard />
      <div class="mt-14 md:mt-20"><NotFor /></div>
    </div>
  </section>

  <Section id="resultaten" label="Resultaten" title="Wat het opleverde" intro="Elke workflow is nu een concept. Zodra een pilot een resultaat heeft, komt het hier te staan: een cijfer, of in elk geval wat er veranderde. Tot dan staat er niets.">
    <ul class="grid gap-4 md:grid-cols-3">
      {[1, 2, 3].map((i) => (
        <li class="rounded-xl border-2 border-dashed border-fg/40 p-6">
          <p class="text-[15px]"><Placeholder label={`wat er veranderde bij pilot ${i}, in de woorden van de klant`} /></p>
          <p class="mt-6 flex items-center gap-3 text-sm text-muted"><span class="size-10 shrink-0 rounded-full bg-fg/10" aria-hidden="true"></span><Placeholder label="naam en functie" /></p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="zelftest" label="Zelftest" title="Blijft jouw opvolging liggen?" intro="Vink aan wat klopt. Je ziet meteen welke workflow erbij past.">
    <SelfTest />
  </Section>

  <Section id="uitkomsten" label="Onze oplossing" title="Drie uitkomsten, elk met workflows" intro="Elke workflow hoort bij één van deze drie. Kies wat je nu het meest mist.">
    <ol class="space-y-14 md:space-y-20">
      {tracks.map((t, i) => {
        const list = workflows.filter((w) => w.data.track === t.id);
        return (
          <li class="grid items-start gap-8 md:grid-cols-2 md:gap-14">
            <div class={i % 2 ? 'md:order-2' : ''}>
              <p class="text-sm font-bold text-muted">Uitkomst {i + 1}</p>
              <h3 class="mt-2 text-[2rem] leading-[1.05] md:text-[2.5rem]"><a href={trackHref(t)} class="hover:text-accent">{t.name}</a></h3>
              <p class="mt-4 text-lg text-black/75">{t.promise}</p>
              <p class="mt-6"><a href={trackHref(t)} class="inline-flex items-center gap-2 font-bold text-accent underline underline-offset-4 hover:no-underline">Alles over {t.name.toLowerCase()} <span aria-hidden="true">→</span></a></p>
            </div>
            <ul class="card-brut p-2">
              {list.map((w) => (
                <li class="border-b-2 border-black/15 last:border-b-0"><a href={`/workflows/${w.id}/`} class="group flex items-baseline justify-between gap-4 px-4 py-3 font-medium hover:bg-blue/40"><span>{w.data.name}</span><span aria-hidden="true">→</span></a></li>
              ))}
            </ul>
          </li>
        );
      })}
    </ol>
  </Section>

  <Section id="branches" label="Ook voor" title="Werk je niet in installatie en onderhoud?" intro="Dezelfde workflows, andere woorden. Een inbedrijfstelling, een livegang of een aflevering is dezelfde trigger.">
    <SectorRow />
    <p class="mt-5 text-sm"><a href="/branches/" class="font-medium text-accent underline underline-offset-4 hover:no-underline">Alle branches →</a></p>
  </Section>

  <Section id="proces" label="Pad" title="Van probleem naar resultaat" intro="Je begint met de scan en een nulmeting. Daarna bouwen we de workflow in drie weken en houden we hem draaiende. Elke stap heeft een eindpunt, zodat je weet wanneer hij klaar is. Alle prijzen zijn voorstellen.">
    <ol class="border-b-2 border-fg">
      <li class="grid gap-1 border-t-2 border-fg py-5 md:grid-cols-[12rem_1fr_12rem] md:gap-8">
        <span class="font-bold">Scan</span>
        <span class="text-black/75">Een gesprek van 30 minuten en één pagina met de drie grootste lekken.<span class="mt-1 block text-sm text-black/65">Klaar als: je de pagina hebt, met een nulmeting en een afgesproken doel per lek.</span></span>
        <span class="text-sm text-black/65 md:text-right">Jouw tijd: 10 min vooraf, 30 min</span>
      </li>
      {flow.data.process.map((step) => (
        <li class="grid gap-1 border-t-2 border-fg py-5 md:grid-cols-[12rem_1fr_12rem] md:gap-8">
          <span class="font-bold">Bouwen, {step.when.toLowerCase()}</span>
          <span class="text-black/75">{step.what}{step.done && <span class="mt-1 block text-sm text-black/65">{step.done}</span>}</span>
          <span class="text-sm text-black/65 md:text-right">Jouw tijd: {step.clientTime}</span>
        </li>
      ))}
      <li class="grid gap-1 border-t-2 border-fg py-5 md:grid-cols-[12rem_1fr_12rem] md:gap-8">
        <span class="font-bold">Beheren</span>
        <span class="text-black/75">Elke maand houden we de workflows draaiende en voegen we op jouw verzoek de volgende toe.<span class="mt-1 block text-sm text-black/65">Klaar als: de eerste meting naast de nulmeting staat.</span></span>
        <span class="text-sm text-black/65 md:text-right">Jouw tijd: een korte terugblik</span>
      </li>
    </ol>
    <p class="mt-8 text-sm text-fg/75">Is je verhaal of je pagina de rem? Dan zijn er <a href="/diensten/#extra" class="font-medium text-accent underline underline-offset-4 hover:no-underline">Blueprint en Build</a>.</p>
  </Section>

  <Section id="faq" label="Vragen" title="Veelgestelde vragen">
    <Faq items={faq.map((f) => ({ question: f.data.question, answer: f.data.answer }))} />
    <div class="mt-8"><Button href="/contact/">Plan een kennismaking</Button></div>
  </Section>

  <Newsletter />

  <section class="on-dark" aria-labelledby="cta">
    <div class="mx-auto max-w-6xl px-4 py-24 md:px-8 md:py-36">
      <h2 id="cta" class="max-w-5xl text-4xl leading-[1.05] tracking-[-0.02em] md:text-[4rem]">
        Begin met de scan. In 30 minuten zie je <span class="neon-text">waar je opvolging blijft liggen</span>, en wat dat per jaar kost.
      </h2>
      <div class="mt-12 flex flex-wrap gap-3">
        <Button href="/opvolgscan/">Doe de opvolgscan</Button>
        <Button href="/contact/" variant="ghost-dark">Plan een kennismaking</Button>
      </div>
    </div>
  </section>
</Base>
