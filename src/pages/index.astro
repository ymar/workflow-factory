---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Placeholder from '../components/Placeholder.astro';
import Checklist from '../components/Checklist.astro';
import KapotteLetters from '../components/KapotteLetters.astro';
import Faq from '../components/Faq.astro';
import ProductIcon from '../components/ProductIcon.astro';
import { priceLabel } from '../lib/format';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const faq = (await getCollection('faq'))
  .filter((f) => f.data.page === 'home')
  .sort((a, b) => a.data.order - b.data.order);
const teardowns = (await getCollection('teardowns', (t) => !t.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const blueprint = services.find((s) => s.id === 'blueprint');

const title = 'neon · Marketing automation. Eerst positionering, dan automation';
const description =
  'Ik bouw marketing automation voor traditionele B2B-bedrijven. Eerst een positionering die helder en anders is. Dan pagina\'s en automation die werken.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'neon',
    url: new URL('/', Astro.site).href,
    description,
    areaServed: 'NL',
    knowsAbout: ['Marketing automation', 'CRM', 'Revenue Architecture'],
    makesOffer: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.data.name, description: s.data.summary },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.data.question,
      acceptedAnswer: { '@type': 'Answer', text: f.data.answer },
    })),
  },
];

const story = [
  { word: 'Gas', product: 'Blueprint', id: 'blueprint', text: 'Je positie is er al. Ze zit in hoe je bedrijf begon en in waarom klanten voor je kiezen. Ze is alleen nog niet zichtbaar. Blueprint legt haar vast, met het verhaal erbij.' },
  { word: 'Buis', product: 'Build', id: 'build', text: 'Pagina\'s die je positionering laten zien. Elk met een formulier en een bedankpagina met een volgende stap.' },
  { word: 'Stroom', product: 'Flow', id: 'flow', text: 'Automation die je verhaal elke dag vertelt, tot de tweede bestelling. Uit een bibliotheek van kant-en-klare journeys.' },
];
const nots = [
  'Geen campagnes op een positionering die niet klopt.',
  'Geen koude e-mail naar gekochte lijsten.',
  'Geen Salesforce.',
  'Geen volledige websiteredesign.',
  'Geen facturatie per uur.',
];
---
<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero-glow">
    <div class="mx-auto flex min-h-[calc(100svh-4rem)] max-w-6xl flex-col justify-between px-4 pb-10 pt-16 md:px-8 md:pt-28">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-sage">Voor traditionele B2B-bedrijven</p>
        <h1 class="mt-8 max-w-5xl text-[2.35rem] leading-[1.04] tracking-[-0.025em] md:text-8xl">
          Ik bouw marketing automation. En ik zeg vaak: <span class="neon-text flicker-once">nog niet.</span>
        </h1>
        <p class="mt-8 max-w-xl text-lg text-paper/80 md:text-xl">
          Eerst een positionering die helder en anders is. Dan pagina's en automation die werken.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href="/contact/">Plan een kennismaking</Button>
          <Button href="/teardowns/" variant="ghost-dark">Bekijk de teardowns</Button>
        </div>
      </div>
      <ul class="mt-20 grid gap-3 border-t border-paper/15 pt-5 text-sm text-sage sm:grid-cols-3">
        <li>10 jaar marketing automation</li>
        <li>Gebouwd op Revenue Architecture</li>
        <li><Placeholder label="X" /> teardowns</li>
      </ul>
    </div>
  </section>

  <Section id="herken" n="01" label="Herken je dit?" tone="dark" title="Herken je dit?" intro="Vink aan wat klopt. Er wordt niets opgeslagen of verstuurd.">
    <Checklist />
  </Section>

  <Section id="principe" n="02" label="Het principe">
    <p class="max-w-5xl font-display text-4xl leading-[1.08] tracking-[-0.02em] md:text-7xl">
      Een systeem versterkt wat je erin stopt. Een vage positionering wordt alleen sneller vaag.
    </p>
    <div class="mt-16 rounded-3xl bg-forest p-8 md:mt-24 md:p-16">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-sage">Zo klinkt het nu</p>
      <div class="mt-8 max-w-4xl">
        <KapotteLetters
          parts={[
            { text: 'Wij leveren ' }, { text: 'kwaliteit' }, { text: ' en ' }, { text: 'betrouwbare' }, { text: ' ' },
            { text: 'oplossingen' }, { text: '. We ' }, { text: 'ontzorgen' }, { text: ' je. ' },
            { text: 'Voor installatiebedrijven met onderhoudscontracten die elk jaar verlopen.', lit: true },
          ]}
          label="Voorbeeld: een zin met uitgeschakelde woorden"
        />
      </div>
      <p class="mt-8 max-w-xl text-sm text-sage">Voorbeeld. De uitgeschakelde woorden zegt iedereen. Wat blijft branden, kun alleen jij zeggen.</p>
    </div>
  </Section>

  <Section id="neon" n="03" label="Waarom neon" title="Neongas is onzichtbaar. Tot er stroom doorheen gaat.">
    <ol class="grid gap-px overflow-hidden rounded-3xl border border-paper/15 bg-paper/15 md:grid-cols-3">
      {story.map((s) => (
        <li class="flex flex-col bg-night p-8 md:p-10">
          <p class="font-display text-5xl tracking-[-0.02em] md:text-6xl">{s.word}</p>
          <p class="mt-8 text-paper/80">{s.text}</p>
          <p class="mt-auto flex items-center gap-2 pt-10 text-sm font-medium"><ProductIcon id={s.id} class="size-5" /> {s.product}</p>
        </li>
      ))}
    </ol>
    <p class="mt-12 font-display text-3xl md:text-4xl">Je verhaal is er al. Wij zetten er stroom op.</p>
  </Section>

  <Section id="bewijs" n="04" label="Uit 10 jaar" title="Drie korte voorbeelden" intro="Geanonimiseerd. Vul hier echte cases met cijfers in, zodra je ze mag delen.">
    <ul class="grid gap-6 md:grid-cols-3">
      {[1, 2, 3].map((n) => (
        <li class="border-t border-paper pt-6">
          <p class="font-display text-5xl text-paper/70">0{n}</p>
          <p class="mt-6 font-medium"><Placeholder label="Sector en uitgangssituatie" /></p>
          <p class="mt-3 text-paper/80"><Placeholder label="Wat we veranderden" /></p>
          <p class="mt-3 text-paper/80"><Placeholder label="Resultaat in cijfers, na X weken" /></p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="producten" n="05" label="Producten" title="Drie producten. Begin bij Blueprint." intro="Alle prijzen zijn voorstellen. We bevestigen ze in de kennismaking.">
    <ul class="grid gap-4 md:grid-cols-3">
      {services.map((s) => {
        const start = s.id === 'blueprint';
        return (
          <li class={`flex flex-col rounded-3xl p-8 ${start ? 'on-dark' : 'border border-paper/15'}`}>
            <div class="flex items-center justify-between">
              <ProductIcon id={s.id} class={`size-8 ${start ? 'text-mint' : 'text-paper'}`} />
              {start && <span class="rounded-full bg-mint px-3 py-1 text-xs font-semibold text-forest">Startpunt</span>}
            </div>
            <h3 class="mt-10 text-4xl">{s.data.name}</h3>
            <p class={`mt-4 ${start ? 'text-paper/80' : 'text-paper/80'}`}>{s.data.summary}</p>
            <dl class={`mt-8 space-y-2 border-t pt-6 text-sm ${start ? 'border-paper/15' : 'border-paper/15'}`}>
              <div class="flex justify-between gap-4"><dt class={start ? 'text-sage' : 'text-paper/70'}>Doorlooptijd</dt><dd>{s.data.duration}</dd></div>
              {s.data.prices.map((p) => (
                <div class="flex justify-between gap-4"><dt class={start ? 'text-sage' : 'text-paper/70'}>{p.label}</dt><dd class="text-right font-medium">{priceLabel(p)}</dd></div>
              ))}
            </dl>
            <p class={`mt-3 text-xs ${start ? 'text-sage' : 'text-paper/70'}`}>Voorstel{s.data.priceNote && `. ${s.data.priceNote}`}</p>
            <a href={`/${s.id}/`} class={`group mt-auto inline-flex items-center gap-2 pt-10 font-medium ${start ? 'text-mint' : 'text-paper'}`}>
              Meer over {s.data.name} <span aria-hidden="true" class="transition-transform motion-safe:group-hover:translate-x-0.5">→</span>
            </a>
          </li>
        );
      })}
    </ul>
    <a href="/journeys/" class="group mt-4 flex flex-col gap-4 rounded-3xl border border-paper/15 p-8 hover:border-mint/60 md:flex-row md:items-center md:justify-between">
      <span>
        <span class="block text-xs font-medium uppercase tracking-[0.18em] text-sage">Journeybibliotheek</span>
        <span class="mt-3 block text-2xl md:text-3xl">Van aanvraagopvolging tot contractverlenging. Kies de journey die je nodig hebt.</span>
      </span>
      <span class="inline-flex shrink-0 items-center gap-2 font-medium text-mint">Bekijk de bibliotheek <span aria-hidden="true" class="transition-transform motion-safe:group-hover:translate-x-0.5">→</span></span>
    </a>
  </Section>

  <Section id="krijg" n="06" label="Blueprint" title="Wat je van Blueprint krijgt">
    <div class="grid gap-12 md:grid-cols-2">
      <ol class="border-b border-paper/15">
        {blueprint?.data.deliverables.map((d, i) => (
          <li class="grid grid-cols-[3rem_1fr] border-t border-paper/15 py-6">
            <span class="font-display text-2xl text-paper/70">0{i + 1}</span>
            <div>
              <p class="font-display text-3xl">{d.name}</p>
              <p class="mt-2 text-paper/80">{d.format}. {d.size}.</p>
            </div>
          </li>
        ))}
      </ol>
      <figure>
        <div class="flex aspect-[4/5] items-center justify-center rounded-3xl bg-paper/5 p-8 text-center text-paper/75">
          <Placeholder label="Voorbeeldafbeelding: een pagina van de positionering" />
        </div>
        <figcaption class="mt-3 text-sm text-paper/70">Vervang door een echt voorbeeld, zodra die er is.</figcaption>
      </figure>
    </div>
  </Section>

  <Section id="dag" n="07" label="Proces" title="Blueprint, dag voor dag" intro="Ongeveer 6 uur van jouw tijd. Het schrijven doen wij.">
    <ol class="border-b border-paper/15">
      {blueprint?.data.process.map((step) => (
        <li class="grid gap-1 border-t border-paper/15 py-5 md:grid-cols-[16rem_1fr_12rem] md:gap-8">
          <span class="font-medium">{step.when}</span>
          <span class="text-paper/80">{step.what}</span>
          <span class="text-sm text-paper/70 md:text-right">Jouw tijd: {step.clientTime}</span>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="niet" n="08" label="Wat ik niet doe" tone="dark" title="Wat ik niet doe">
    <ul class="border-b border-paper/15">
      {nots.map((n) => <li class="border-t border-paper/15 py-5 font-display text-2xl md:text-4xl">{n}</li>)}
    </ul>
  </Section>

  <Section id="teardowns" n="09" label="Kapotte letters" title="De nieuwste teardowns">
    <ul class="grid gap-4 md:grid-cols-3">
      {teardowns.length > 0
        ? teardowns.map((t) => (
            <li>
              <a href={`/teardowns/${t.id}/`} class="block h-full rounded-3xl border border-paper/15 p-8 hover:border-paper">
                <p class="text-sm text-paper/70">{t.data.company} · {t.data.type}</p>
                <p class="mt-6 font-display text-3xl">{t.data.title}</p>
              </a>
            </li>
          ))
        : [1, 2, 3].map((n) => (
            <li class="rounded-3xl border border-dashed border-paper/30 p-8">
              <p class="text-sm text-paper/70">Nog geen gepubliceerde teardown</p>
              <p class="mt-6 font-display text-3xl"><Placeholder label={`Teardown ${n}: titel`} /></p>
            </li>
          ))}
    </ul>
    <div class="mt-10"><Button href="/teardowns/" variant="ghost-light">Alle teardowns</Button></div>
  </Section>

  <Section id="faq" n="10" label="Vragen" title="Veelgestelde vragen">
    <Faq items={faq.map((f) => ({ question: f.data.question, answer: f.data.answer }))} />
  </Section>

  <section class="on-dark border-t border-paper/10" aria-labelledby="cta">
    <div class="mx-auto max-w-6xl px-4 py-24 md:px-8 md:py-40">
      <h2 id="cta" class="max-w-5xl text-4xl leading-[1.05] tracking-[-0.02em] md:text-7xl">
        Plan 30 minuten. Ik zeg je eerlijk of je klaar bent voor campagnes, of eerst <span class="neon-text">je positionering</span> moet fixen.
      </h2>
      <div class="mt-12"><Button href="/contact/">Plan een kennismaking</Button></div>
    </div>
  </section>
</Base>
