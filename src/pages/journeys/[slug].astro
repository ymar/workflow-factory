---
import { getCollection, getEntries, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import { priceLabel } from '../../lib/format';
import { phaseById } from '../../lib/loop';
import { statusLabel } from '../../lib/status';
import { fieldAnchor, metricAnchor, objectLabel, segmentHref, segmentLabel, sortJourneys, whenLabel, withLabels } from '../../lib/library';
import { assertLibrary } from '../../lib/library-check';

export async function getStaticPaths() {
  await assertLibrary();
  const all = sortJourneys(await getCollection('journeys'));
  return all.map((journey, i) => ({
    params: { slug: journey.id },
    props: { journey, prev: all[i - 1], following: all[i + 1] },
  }));
}

const { journey, prev, following } = Astro.props;
const { code, name, version, phase, summary, trigger, goal, enroll, steps, exit, handover, segments, needs_blueprint, owner, priority, status } = journey.data;
const st = statusLabel[status];
const loopPhase = phaseById(phase);
const next = journey.data.next ? await getEntry(journey.data.next) : undefined;
const fields = await getEntries(journey.data.fields);
const metrics = await getEntries(journey.data.metrics);
const labels = new Map((await getCollection('fields')).map((f) => [f.id, f.data.label]));
const say = (text: string) => withLabels(text, labels);
const flow = await getEntry('services', 'flow');
if (!flow) throw new Error('Missing services/flow.json');

const actionStyle = {
  'e-mail': 'border-paper/30 text-paper',
  taak: 'border-mint/50 text-mint',
  melding: 'border-sage/50 text-sage',
  systeem: 'border-paper/20 text-paper/70',
};
const metricTypes = ['volume', 'conversie', 'doorlooptijd', 'omzet'] as const;
const typeLabel = { volume: 'Volume', conversie: 'Conversie', doorlooptijd: 'Doorlooptijd', omzet: 'Omzet' };

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${name}: journey in HubSpot of ActiveCampaign`,
    description: summary,
    provider: { '@type': 'ProfessionalService', name: 'neon' },
    areaServed: 'NL',
    offers: flow.data.prices.map((p) => ({
      '@type': 'Offer',
      priceCurrency: 'EUR',
      priceSpecification: { '@type': 'PriceSpecification', minPrice: p.from, maxPrice: p.to ?? p.from, priceCurrency: 'EUR' },
    })),
  },
];
---
<Base title={`${name} · Journey | neon`} description={`${summary} ${trigger}`} path={`/journeys/${journey.id}/`} jsonLd={jsonLd}>
  <PageHero icon="flow" kicker={`${code} · Fase ${loopPhase.name} · v${version}`} title={name} intro={summary}>
    <Button href="/contact/">Plan een kennismaking</Button>
    <Button href={`/journeys/#${loopPhase.id}`} variant="ghost-dark">Alle journeys in {loopPhase.name}</Button>
  </PageHero>
  <div>
    <div class="mx-auto max-w-6xl px-4 pb-16 md:px-8">
      <div class="flex max-w-3xl flex-col gap-3 border-t border-paper/15 pt-5 text-sage">
        <p class="flex items-start gap-3">
          <span class={`mt-0.5 shrink-0 rounded-full border px-3 py-1 text-xs font-medium ${st.style}`}>{st.label}</span>
          <span>{st.text}</span>
        </p>
        {!needs_blueprint && (
          <p class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 rounded-full bg-mint px-3 py-1 text-xs font-semibold text-forest">Kan meteen</span>
            <span>Deze journey hoeft niet te wachten op je positionering.</span>
          </p>
        )}
      </div>
    </div>
  </div>

  <Section id="start" n="01" label="Start en doel" title="Wanneer hij start, en wanneer hij stopt">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl border border-paper/15 p-8">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-sage">Start</p>
        <p class="mt-6 text-2xl leading-snug">{trigger}</p>
        <dl class="mt-8 space-y-4 border-t border-paper/15 pt-6 text-sm">
          <div class="grid grid-cols-[7rem_1fr] gap-3"><dt class="text-sage">Object</dt><dd>{objectLabel[enroll.object]}</dd></div>
          <div class="grid grid-cols-[7rem_1fr] gap-3"><dt class="text-sage">Moment</dt><dd>{enroll.at ? whenLabel({ at: enroll.at }, labels) : `Zodra ${say(enroll.on ?? '').toLowerCase()}`}</dd></div>
          {enroll.if.length > 0 && <div class="grid grid-cols-[7rem_1fr] gap-3"><dt class="text-sage">Alleen als</dt><dd><ul class="space-y-1">{enroll.if.map((c) => <li>{say(c)}</li>)}</ul></dd></div>}
          {enroll.not_if.length > 0 && <div class="grid grid-cols-[7rem_1fr] gap-3"><dt class="text-sage">Niet als</dt><dd><ul class="space-y-1">{enroll.not_if.map((c) => <li>{say(c)}</li>)}</ul></dd></div>}
          <div class="grid grid-cols-[7rem_1fr] gap-3"><dt class="text-sage">Eigenaar</dt><dd class="capitalize">{owner}</dd></div>
          <div class="grid grid-cols-[7rem_1fr] gap-3"><dt class="text-sage">Voorrang</dt><dd>{priority} <span class="text-paper/70">(bij overlap wint het laagste getal)</span></dd></div>
        </dl>
      </div>
      <div class="rounded-3xl border border-paper/15 p-8">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-sage">Doel</p>
        <p class="mt-6 text-2xl leading-snug">{goal}</p>
        <dl class="mt-8 space-y-4 border-t border-paper/15 pt-6 text-sm">
          <div class="grid grid-cols-[7rem_1fr] gap-3"><dt class="text-sage">Stopt zodra</dt><dd><ul class="space-y-1">{exit.map((c) => <li>{say(c)}</li>)}</ul></dd></div>
        </dl>
      </div>
    </div>
  </Section>

  <Section id="stappen" n="02" label="Stappen" title="Zo loopt het" intro="Voorbeeldopzet. Per e-mail staat wat hij moet bereiken. De tekst zelf schrijven we op jouw positionering.">
    <ol class="border-b border-paper/15">
      {steps.map((s) => (
        <li class="grid gap-2 border-t border-paper/15 py-5 md:grid-cols-[13rem_7rem_1fr] md:gap-8">
          <span class="font-medium">{whenLabel(s, labels)}</span>
          <span><span class={`inline-block rounded-full border px-3 py-0.5 text-xs font-medium ${actionStyle[s.action]}`}>{s.action}</span></span>
          <div>
            {s.if && <p class="mb-2 text-sm text-mint">Alleen als {say(s.if).toLowerCase()}</p>}
            <p class="text-paper/85 md:text-lg">{s.brief}</p>
            <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm text-paper/70">
              {s.owner && <span>Eigenaar: <span class="capitalize">{s.owner}</span></span>}
              {s.to && <span>Aan: {say(s.to).toLowerCase()}</span>}
              {s.sla && <span>Binnen {s.sla}</span>}
              {s.sets && <span>Legt vast: {say(s.sets).toLowerCase()}</span>}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="overdracht" n="03" label="Overdracht" title="Waar het stopt">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl border border-paper/15 p-8">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-mint">Gelukt</p>
        <p class="mt-6 text-xl leading-snug">{handover.won}</p>
      </div>
      {handover.lost && (
        <div class="rounded-3xl border border-paper/15 p-8">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-sage">Niet gelukt</p>
          <p class="mt-6 text-xl leading-snug">{handover.lost}</p>
        </div>
      )}
    </div>
    {next && <div class="mt-10"><Button href={`/journeys/${next.id}/`} variant="ghost-light">Volgende journey: {next.data.name}</Button></div>}
  </Section>

  <Section id="velden" n="04" label="Data" title="Wat je in je CRM nodig hebt" intro="Ontbreekt een verplicht veld, dan start de journey niet, of op het verkeerde moment.">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[40rem] text-left text-sm">
        <thead class="text-xs uppercase tracking-[0.12em] text-sage">
          <tr><th class="py-3 pr-4 font-medium">Veld</th><th class="py-3 pr-4 font-medium">Type</th><th class="py-3 pr-4 font-medium">Bron</th><th class="py-3 font-medium">Verplicht</th></tr>
        </thead>
        <tbody>
          {fields.map((f) => (
            <tr class="border-t border-paper/15 align-top">
              <td class="py-4 pr-4">
                <a href={`/journeys/data/#${fieldAnchor(f.id)}`} class="font-medium hover:text-mint hover:underline">{f.data.label}</a>
                <span class="mt-1 block font-mono text-xs text-sage">{f.id}</span>
              </td>
              <td class="py-4 pr-4 text-paper/80">{f.data.type}</td>
              <td class="py-4 pr-4 text-paper/80">{f.data.source}</td>
              <td class="py-4 text-paper/80">{f.data.required ? 'Ja' : 'Nee'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <Section id="dashboard" n="05" label="Dashboard" title="Wat je dashboard laat zien" intro="Elke meting is één keer gedefinieerd, zodat je journeys met elkaar kunt vergelijken.">
    <ul class="grid gap-4 md:grid-cols-2">
      {metricTypes.flatMap((t) => metrics.filter((m) => m.data.type === t)).map((m) => (
        <li class="rounded-3xl border border-paper/15 p-8">
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-sage">{typeLabel[m.data.type]} · {m.data.unit}</p>
          <p class="mt-6 text-2xl leading-snug"><a href={`/journeys/data/#${metricAnchor(m.id)}`} class="hover:text-mint hover:underline">{m.data.label}</a></p>
          {m.data.type === 'conversie'
            ? <p class="mt-3 text-paper/80">{m.data.numerator}, gedeeld door {m.data.denominator}.</p>
            : <p class="mt-3 text-paper/80">{m.data.definition}</p>}
          <p class="mt-3 text-sm text-paper/70">Gemeten {m.data.period}.</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="past" n="06" label="Past bij" title="Voor wie">
    <ul class="flex flex-wrap gap-3">
      {segments.map((s) => (
        <li>
          {segmentHref[s]
            ? <a href={segmentHref[s]} class="inline-block rounded-full border border-paper/30 px-4 py-2 hover:border-mint hover:text-mint">{segmentLabel[s]} →</a>
            : <span class="inline-block rounded-full border border-paper/15 px-4 py-2 text-paper/80">{segmentLabel[s]}</span>}
        </li>
      ))}
    </ul>
    <p class="mt-8 text-paper/80">Werkt in HubSpot of ActiveCampaign. Geen Salesforce.</p>
  </Section>

  <Section id="prijs" n="07" label="Prijs" tone="dark" title={`${name}, ingericht in ${flow.data.duration.replace(' per journey', '')}`}>
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        {flow.data.prices.map((p) => <p class="font-display text-5xl tracking-[-0.03em] md:text-6xl">{priceLabel(p)}</p>)}
        <p class="mt-3 text-paper/80">Per journey. Voorstel. {flow.data.priceNote}</p>
      </div>
      <Button href="/contact/">Plan een kennismaking</Button>
    </div>
  </Section>

  <p class="mx-auto max-w-6xl px-4 pb-8 text-sm text-paper/70 md:px-8">
    {code} versie {version}. Opbouw vrij te gebruiken met naamsvermelding, onder <a href="https://creativecommons.org/licenses/by/4.0/deed.nl" class="underline underline-offset-4 hover:text-mint">CC BY 4.0</a>.
  </p>
  <nav aria-label="Andere journeys" class="mx-auto grid max-w-6xl gap-4 px-4 pb-24 md:grid-cols-2 md:px-8">
    {prev ? (
      <a href={`/journeys/${prev.id}/`} class="rounded-3xl border border-paper/15 p-6 hover:border-mint/60">
        <span class="text-xs uppercase tracking-[0.18em] text-sage">← Vorige</span>
        <span class="mt-2 block text-2xl">{prev.data.name}</span>
      </a>
    ) : <span />}
    {following && (
      <a href={`/journeys/${following.id}/`} class="rounded-3xl border border-paper/15 p-6 text-right hover:border-mint/60">
        <span class="text-xs uppercase tracking-[0.18em] text-sage">Volgende →</span>
        <span class="mt-2 block text-2xl">{following.data.name}</span>
      </a>
    )}
  </nav>
</Base>
