---
// One line of an example email: CRM fields link to the data section, [spots] are highlighted.
import { library } from '../lib/site';
import { fieldAnchor, mailTokens } from '../lib/library';
interface Props {
  text: string;
  labels: Map<string, string>;
}
const { text, labels } = Astro.props;
---
{mailTokens(text, library.form).map((t) =>
  t.kind === 'field' ? <a href={`#${fieldAnchor(t.value)}`} class="mail-field" title={labels.get(t.value)}>{`{{${t.value}}}`}</a>
  : t.kind === 'fill' ? <mark class="mail-fill">{t.value}</mark>
  : t.value
)}
