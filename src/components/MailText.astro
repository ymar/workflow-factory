---
// One line of an example email. A CRM field shows its example value (underlined) and, in the
// "Velden" view, its {{field}} code instead. [Spots] the sender fills in are highlighted.
import { library } from '../lib/site';
import { formatExample, mailTokens } from '../lib/library';
interface Props {
  text: string;
  fields: Map<string, { label: string; type: string; example: string }>;
}
const { text, fields } = Astro.props;
---
{mailTokens(text, library.form).map((t) => {
  if (t.kind === 'text') return t.value;
  if (t.kind === 'fill') return <mark class="mail-fill">{t.value}</mark>;
  const f = fields.get(t.value);
  return <span class="mv" title={f?.label}><span class="mv-ex">{f ? formatExample(f.example, f.type) : t.value}</span><code class="mv-f">{`{{${t.value}}}`}</code></span>;
})}
