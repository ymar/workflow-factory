---
import type { CollectionEntry } from 'astro:content';
import { statusLabel } from '../lib/status';
import { phaseById } from '../lib/loop';
import FlowThumb from './FlowThumb.astro';
interface Props {
  workflow: CollectionEntry<'workflows'>;
  showPhase?: boolean;
}
const { workflow, showPhase = false } = Astro.props;
const { code, name, summary, trigger, needs_blueprint, status } = workflow.data;
const st = statusLabel[status];
---
<article class="group relative flex h-full flex-col rounded-xl border-2 border-fg p-6 transition-colors hover:border-accent/60 md:p-8">
  <div class="mb-6 rounded-lg bg-fg/[0.035] px-2 py-3"><FlowThumb workflow={workflow} /></div>
  <p class="text-xs font-medium tracking-[0.1em] text-muted">{code}{showPhase && ` · ${phaseById(workflow.data.phase).name}`}</p>
  <p class="mb-6 mt-3 flex flex-wrap gap-2 text-xs">
    <span class={`rounded-md border px-2 py-0.5 font-medium ${st.style}`}>{st.label}</span>
    {!needs_blueprint && <span class="rounded-md bg-mint px-2 py-0.5 font-semibold text-forest">Kan meteen</span>}
  </p>
  <h3 class="text-3xl">
    <a href={`/workflows/${workflow.id}/`} class="rounded after:absolute after:inset-0 after:rounded-xl after:content-['']">{name}</a>
  </h3>
  <p class="mt-3 text-fg/80">{summary}</p>
  <p class="mt-6 border-t border-fg/15 pt-4 text-sm text-fg/70"><span class="text-muted">Start bij:</span> {trigger}</p>
  <span aria-hidden="true" class="mt-auto inline-flex items-center gap-2 pt-8 font-medium text-accent">
    Bekijk de workflow <span class="transition-transform motion-safe:group-hover:translate-x-0.5">→</span>
  </span>
</article>
