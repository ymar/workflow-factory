---
// An outcome page: title, the promise as an intro, the scan as the first step, then the workflows as cards.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import OutcomeDl from './OutcomeDl.astro';
import ScanStrip from './ScanStrip.astro';
import WorkflowCard from './WorkflowCard.astro';
import { sortWorkflows } from '../lib/library';
import { tracks, trackHref } from '../lib/tracks';

interface Props {
  id: string;
}
const track = tracks.find((t) => t.id === Astro.props.id);
if (!track) throw new Error(`Unknown track ${Astro.props.id}`);
const workflows = sortWorkflows(await getCollection('workflows')).filter((w) => w.data.track === track.id);
const path = trackHref(track);
const crumbs: [string, string][] = [['/', 'Home'], ['/workflows/', 'Workflows'], [path, track.name]];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map(([href, label], i) => ({ '@type': 'ListItem', position: i + 1, name: label, item: new URL(href, Astro.site).href })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: track.name,
    itemListElement: workflows.map((w, i) => ({ '@type': 'ListItem', position: i + 1, name: w.data.name, url: new URL(`/workflows/${w.id}/`, Astro.site).href })),
  },
];
const others = tracks.filter((t) => t.id !== track.id);
---
<Base title={`${track.seo.title} | Workflow Factory`} description={track.seo.description} path={path} jsonLd={jsonLd}>
  <PageHero crumbs={crumbs} kicker={`${track.name} · ${workflows.length} workflows`} title={track.headline} intro={track.intro} />

  <div class="mx-auto max-w-6xl px-4 pb-12 md:px-8"><OutcomeDl outcome={track.statement} /></div>

  <ScanStrip />

  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <section id="workflows" aria-labelledby="workflows-title" class="scroll-mt-24 border-t border-fg/10 py-14 md:py-20">
      <p class="text-sm font-medium text-accent">Stap 2</p>
      <h2 id="workflows-title" class="mt-2 text-[1.75rem] md:text-[2.25rem]">De workflows</h2>
      {track.honest && <p class="mt-3 max-w-2xl text-fg/80">{track.honest}</p>}
      <ul class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {workflows.map((w) => <li><WorkflowCard workflow={w} showPhase /></li>)}
      </ul>
    </section>

    <section aria-labelledby="andere-title" class="border-t border-fg/10 py-14 md:py-20">
      <h2 id="andere-title" class="text-[1.75rem] md:text-[2rem]">Andere uitkomsten</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {others.map((t) => (
          <li>
            <a href={trackHref(t)} class="group flex h-full flex-col rounded-xl border-2 border-fg bg-white p-6 transition-colors hover:border-fg/40">
              <span class="text-lg font-semibold tracking-[-0.015em]">{t.name}</span>
              <span class="mt-2 text-[15px] text-fg/75">{t.promise}</span>
              <span aria-hidden="true" class="mt-auto pt-6 text-accent transition-transform motion-safe:group-hover:translate-x-0.5">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
