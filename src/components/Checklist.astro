---
// The only script on the site. Native checkboxes: keyboard and screen readers work without it.
const items = [
  'We concurreren vooral op prijs.',
  'Onze website zegt hetzelfde als die van de concurrent.',
  'We sturen campagnes, maar de reacties blijven uit.',
  'Aanvragen en offertes blijven liggen.',
  'We hebben een CRM, maar weten niet wat we erin moeten zetten.',
];
const verdicts = [
  'Niets aangevinkt? Dan heb je een sterke positionering. Of je kijkt er te dichtbij naar.',
  'Een paar dingen herken je. Begin dan bij je positionering, niet bij de campagnes.',
  'Een paar dingen herken je. Begin dan bij je positionering, niet bij de campagnes.',
  'Dan ligt het niet aan je campagnes. Het ligt aan je positionering.',
  'Dan ligt het niet aan je campagnes. Het ligt aan je positionering.',
  'Dan ligt het niet aan je campagnes. Het ligt aan je positionering.',
];
---
<div data-checklist>
  <fieldset>
    <legend class="sr-only">Herken je dit?</legend>
    <ul class="border-b border-fg/15">
      {items.map((text, i) => (
        <li>
          <label class="check-item flex cursor-pointer items-center gap-5 border-t border-fg/15 py-5 md:py-6">
            <input type="checkbox" name="herken" value={String(i)} class="check-box" />
            <span class="check-text font-display text-xl leading-snug text-fg/85 md:text-3xl">{text}</span>
          </label>
        </li>
      ))}
    </ul>
  </fieldset>
  <p data-verdict aria-live="polite" class="mt-8 text-lg text-muted">Vink aan wat klopt.</p>
</div>

<script define:vars={{ verdicts }}>
  const root = document.querySelector('[data-checklist]');
  const out = root.querySelector('[data-verdict]');
  const boxes = root.querySelectorAll('input[type="checkbox"]');
  const update = () => {
    const n = [...boxes].filter((b) => b.checked).length;
    out.textContent = `${n} van ${boxes.length} aangevinkt. ${verdicts[n]}`;
  };
  boxes.forEach((b) => b.addEventListener('change', update));
  update();
</script>
