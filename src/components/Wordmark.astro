---
// "neon" drawn as monoline neon tubes: one stroke weight, round caps, no fill.
// Glows on dark backgrounds, plain forest on light ones.
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: className = '' } = Astro.props;
const stroke = tone === 'dark' ? '#5ff0b8' : '#0f2e23';
---
<svg
  class={`w-auto ${tone === 'dark' ? 'neon-tube' : ''} ${className}`}
  viewBox="0 14 144 40"
  role="img"
  aria-label="neon"
  fill="none"
  stroke={stroke}
  stroke-width="4"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M6 48V20M6 31C6 24 11 20 18 20S30 24 30 31V48" />
  <path d="M38 34H66A14 14 0 1 0 61.9 43.9" />
  <path d="M76 34A14 14 0 1 1 104 34A14 14 0 1 1 76 34" />
  <path d="M114 48V20M114 31C114 24 119 20 126 20S138 24 138 31V48" />
</svg>
