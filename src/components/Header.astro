---
import Wordmark from './Wordmark.astro';
const links = [
  { href: '/rewind/', label: 'Rewind' },
  { href: '/play/', label: 'Play' },
  { href: '/autoplay/', label: 'Autoplay' },
  { href: '/installatie-onderhoud/', label: 'Installatie en onderhoud' },
  { href: '/teardowns/', label: 'Teardowns' },
  { href: '/over/', label: 'Over' },
  { href: '/contact/', label: 'Contact' },
];
---
<header class="on-dark">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4 md:px-6">
    <a href="/" class="inline-flex rounded" aria-label="Neeeon, naar de homepage">
      <Wordmark tone="dark" />
    </a>
    <nav aria-label="Hoofdmenu" class="w-full md:w-auto">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {links.map((l) => (
          <li><a href={l.href} class="rounded text-paper underline-offset-4 hover:text-mint hover:underline">{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
