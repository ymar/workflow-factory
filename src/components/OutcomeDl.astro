---
// The outcome in four parts: who it is for, the problem, what changes, and the result. Used on workflow, outcome and sector pages.
interface Props {
  outcome: { context: string; issue: string; change: string; result: string };
}
const { outcome } = Astro.props;
---
<dl class="grid border-y border-fg/10 md:grid-cols-2 lg:grid-cols-4">
  {[
    ['Voor wie', outcome.context],
    ['Het probleem', outcome.issue],
    ['Wat er verandert', outcome.change],
    ['Wat het oplevert', outcome.result],
  ].map(([term, text], i) => (
    <div class={`py-6 lg:px-6 ${i > 0 ? 'border-t border-fg/10 lg:border-l lg:border-t-0' : 'lg:pl-0'} ${i === 1 ? 'md:border-t-0 md:border-l md:pl-6' : ''} ${i === 2 ? 'md:pl-0 lg:pl-6' : ''} ${i === 3 ? 'md:border-l md:pl-6' : ''}`}>
      <dt class={`text-[13px] ${i === 3 ? 'font-medium text-accent' : 'text-muted'}`}>{term}</dt>
      <dd class={`mt-2 leading-snug ${i === 3 ? 'font-medium' : ''}`}>{text}</dd>
    </div>
  ))}
</dl>
