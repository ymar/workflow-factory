---
import type { CollectionEntry } from 'astro:content';
import { statusLabel } from '../lib/status';
interface Props {
  journey: CollectionEntry<'journeys'>;
}
const { journey } = Astro.props;
const { code, name, summary, trigger, needs_blueprint, status } = journey.data;
const st = statusLabel[status];
---
<article class="group relative flex h-full flex-col rounded-3xl border border-paper/15 p-8 transition-colors hover:border-mint/60">
  <p class="mb-6 flex flex-wrap gap-2 text-xs">
    <span class={`rounded-full border px-3 py-1 font-medium ${st.style}`}>{st.label}</span>
    {!needs_blueprint && <span class="rounded-full bg-mint px-3 py-1 font-semibold text-forest">Kan meteen</span>}
    <span class="ml-auto py-1 font-medium tracking-[0.1em] text-sage">{code}</span>
  </p>
  <h3 class="text-3xl">
    <a href={`/journeys/${journey.id}/`} class="rounded after:absolute after:inset-0 after:rounded-3xl after:content-['']">{name}</a>
  </h3>
  <p class="mt-3 text-paper/80">{summary}</p>
  <p class="mt-6 border-t border-paper/15 pt-4 text-sm text-paper/70"><span class="text-sage">Start bij:</span> {trigger}</p>
  <span aria-hidden="true" class="mt-auto inline-flex items-center gap-2 pt-8 font-medium text-mint">
    Bekijk de journey <span class="transition-transform motion-safe:group-hover:translate-x-0.5">→</span>
  </span>
</article>
