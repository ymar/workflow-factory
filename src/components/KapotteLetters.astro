---
// A sentence as a neon sign. Generic words are switched off (dimmed), what stays lit is distinct.
// Parts without lit or plain are switched off. plain parts are neutral connector text.
interface Part {
  text: string;
  lit?: boolean;
  plain?: boolean;
}
interface Props {
  parts: Part[];
  label?: string;
}
const { parts, label = 'Voorbeeld van een kapot bord' } = Astro.props;
---
<p class="font-serif text-3xl leading-[1.15] tracking-[-0.01em] md:text-5xl" aria-label={label}>
  {parts.map((p) => (
    <span class={p.lit ? 'neon-text' : p.plain ? 'text-paper' : 'text-dim'}>{p.text}</span>
  ))}
</p>
