---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost-dark' | 'ghost-light';
  arrow?: boolean;
  class?: string;
}
const { href, variant = 'primary', arrow = true, class: className = '' } = Astro.props;
const styles = {
  // Ink on light pages, paper on dark blocks: fg and bg flip inside .on-dark.
  primary: 'bg-fg text-bg hover:bg-accent',
  'ghost-dark': 'border border-fg/25 text-fg hover:border-fg/60',
  'ghost-light': 'border border-fg/25 text-fg hover:border-fg/60',
};
---
<a href={href} class={`group inline-flex items-center gap-2 rounded-[10px] px-5 py-3 text-[15px] font-medium transition-colors ${styles[variant]} ${className}`}>
  <slot />
  {arrow && <span aria-hidden="true" class="transition-transform motion-safe:group-hover:translate-x-0.5">→</span>}
</a>
