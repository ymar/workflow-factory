---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost-dark' | 'ghost-light';
  arrow?: boolean;
  class?: string;
}
const { href, variant = 'primary', arrow = true, class: className = '' } = Astro.props;
const styles = {
  primary: 'bg-mint text-forest hover:brightness-95',
  'ghost-dark': 'border border-fg/30 text-fg hover:border-accent hover:text-accent',
  'ghost-light': 'border border-fg/30 text-fg hover:border-accent hover:text-accent',
};
---
<a href={href} class={`group inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-[15px] font-medium transition-colors ${styles[variant]} ${className}`}>
  <slot />
  {arrow && <span aria-hidden="true" class="transition-transform motion-safe:group-hover:translate-x-0.5">→</span>}
</a>
