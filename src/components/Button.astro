---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost-dark' | 'ghost-light';
  arrow?: boolean;
  class?: string;
}
const { href, variant = 'primary', arrow = true, class: className = '' } = Astro.props;
// Thick black border, blue fill with black text for the main action, plain for the second one.
const styles = {
  primary: 'btn-primary',
  'ghost-dark': 'btn-ghost',
  'ghost-light': 'btn-ghost',
};
---
<a href={href} class={`group btn ${styles[variant]} ${className}`}>
  <slot />
  {arrow && <span aria-hidden="true">→</span>}
</a>
