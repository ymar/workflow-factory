---
// A topic page: title, a short introduction, the workflows per phase, and the other topics.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import WorkflowCard from './WorkflowCard.astro';
import { phaseById } from '../lib/loop';
import { sortWorkflows } from '../lib/library';
import { topics, topicHref } from '../lib/topics';

interface Props {
  id: string;
}
const topic = topics.find((t) => t.id === Astro.props.id);
if (!topic) throw new Error(`Unknown topic ${Astro.props.id}`);
const all = sortWorkflows(await getCollection('workflows'));
const workflows = all.filter((w) => (topic.phases as string[]).includes(w.data.phase));
const path = topicHref(topic);
const crumbs: [string, string][] = [['/', 'Home'], ['/workflows/', 'Workflows'], [path, topic.name]];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map(([href, label], i) => ({ '@type': 'ListItem', position: i + 1, name: label, item: new URL(href, Astro.site).href })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: topic.seo.title,
    itemListElement: workflows.map((w, i) => ({ '@type': 'ListItem', position: i + 1, name: w.data.name, url: new URL(`/workflows/${w.id}/`, Astro.site).href })),
  },
];
const others = topics.filter((t) => t.id !== topic.id);
---
<Base title={`${topic.seo.title} | Workflow Factory`} description={topic.seo.description} path={path} jsonLd={jsonLd}>
  <PageHero crumbs={crumbs} kicker={`Onderwerp · ${workflows.length} workflow${workflows.length === 1 ? '' : 's'}`} title={topic.name} intro={topic.intro} />

  <div class="mx-auto max-w-6xl px-4 md:px-8">
    {topic.phases.map((id) => {
      const phase = phaseById(id);
      const list = workflows.filter((w) => w.data.phase === id);
      return (
        <section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-24 border-t border-fg/10 py-14 md:py-20">
          <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
            <h2 id={`${id}-title`} class="text-[1.75rem] md:text-[2rem]">Fase {phase.name.toLowerCase()}</h2>
            <p class="text-sm text-muted">{phase.revenue}</p>
          </div>
          <p class="mt-3 max-w-2xl text-fg/80"><span class="text-fg">Waar het lekt:</span> {phase.leak}</p>
          <ul class="mt-8 grid gap-4 md:grid-cols-2">
            {list.map((w) => <li><WorkflowCard workflow={w} /></li>)}
          </ul>
        </section>
      );
    })}

    <section aria-labelledby="andere-title" class="border-t border-fg/10 py-14 md:py-20">
      <h2 id="andere-title" class="text-[1.75rem] md:text-[2rem]">Andere onderwerpen</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {others.map((t) => (
          <li>
            <a href={topicHref(t)} class="group flex h-full flex-col rounded-xl border border-fg/15 bg-white p-6 transition-colors hover:border-fg/40">
              <span class="text-lg font-semibold tracking-[-0.015em]">{t.name}</span>
              <span class="mt-2 text-[15px] text-fg/75">{t.intro.split('. ')[0]}.</span>
              <span aria-hidden="true" class="mt-auto pt-6 text-accent transition-transform motion-safe:group-hover:translate-x-0.5">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
