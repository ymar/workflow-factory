---
// Agency-style section: numbered label on a hairline, large title, then content.
interface Props {
  id: string;
  n?: string;
  label: string;
  title?: string;
  intro?: string;
  tone?: 'light' | 'dark';
}
const { id, n, label, title, intro, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---
<section id={id} class={dark ? 'on-dark' : ''} aria-labelledby={`${id}-title`}>
  <div class="mx-auto max-w-6xl px-4 md:px-8"><div class={`py-16 md:py-24 ${dark ? '' : 'border-t border-fg/10'}`}>
    <p class="text-sm font-medium text-accent">{label}</p>
    {title ? (
      <h2 id={`${id}-title`} class="mt-2 max-w-3xl text-[2rem] leading-[1.1] md:text-[2.75rem]">{title}</h2>
    ) : (
      <h2 id={`${id}-title`} class="sr-only">{label}</h2>
    )}
    {intro && <p class={`mt-4 max-w-2xl text-lg ${dark ? 'text-fg/80' : 'text-fg/75'}`}>{intro}</p>}
    <div class={title || intro ? 'mt-10 md:mt-12' : 'mt-6'}>
      <slot />
    </div>
  </div></div>
</section>
