---
// Agency-style section: numbered label on a hairline, large title, then content.
interface Props {
  id: string;
  n?: string;
  label: string;
  title?: string;
  intro?: string;
  tone?: 'light' | 'dark';
}
const { id, n, label, title, intro, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---
<section id={id} class={dark ? 'on-dark' : ''} aria-labelledby={`${id}-title`}>
  <div class="mx-auto max-w-6xl px-4 py-20 md:px-8 md:py-32">
    <p class={`flex items-baseline gap-4 border-t pt-5 text-xs font-medium uppercase tracking-[0.18em] ${dark ? 'border-paper/15 text-sage' : 'border-paper/15 text-paper/70'}`}>
      {n && <span class="text-mint">{n}</span>}
      <span>{label}</span>
    </p>
    {title ? (
      <h2 id={`${id}-title`} class="mt-10 max-w-4xl text-4xl leading-[1.05] tracking-[-0.015em] md:text-6xl">{title}</h2>
    ) : (
      <h2 id={`${id}-title`} class="sr-only">{label}</h2>
    )}
    {intro && <p class={`mt-6 max-w-2xl text-lg ${dark ? 'text-paper/80' : 'text-paper/75'}`}>{intro}</p>}
    <div class={title || intro ? 'mt-12 md:mt-16' : 'mt-10'}>
      <slot />
    </div>
  </div>
</section>
