---
// Shared productized-offer page: signals, deliverables, process, price, not included, FAQ.
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Section from './Section.astro';
import Button from './Button.astro';
import Faq from './Faq.astro';
import { priceLabel } from '../lib/format';

interface Props {
  id: 'blueprint' | 'build' | 'flow';
  headline: string;
  accent: string;
  title: string;
  description: string;
  signals: string[];
  kicker?: string;
  signalsTitle: string;
  deliverablesTitle: string;
  processTitle: string;
  processIntro?: string;
  priceTitle: string;
  priceIntro?: string;
}
const { id, headline, accent, title, description, signals, kicker, signalsTitle, deliverablesTitle, processTitle, processIntro, priceTitle, priceIntro } = Astro.props;

const service = await getEntry('services', id);
if (!service) throw new Error(`Missing services/${id}.json`);
const faq = (await getCollection('faq'))
  .filter((f) => f.data.page === id)
  .sort((a, b) => a.data.order - b.data.order);
const { name, summary, duration, prices, priceNote, requires, deliverables, process, notIncluded, priceStatus } = service.data;
const proposal = priceStatus === 'proposal';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name,
    description: summary,
    provider: { '@type': 'ProfessionalService', name: 'neon' },
    areaServed: 'NL',
    offers: prices.map((p) => ({
      '@type': 'Offer',
      name: p.label,
      priceCurrency: 'EUR',
      ...(p.to
        ? { priceSpecification: { '@type': 'PriceSpecification', minPrice: p.from, maxPrice: p.to, priceCurrency: 'EUR' } }
        : { price: p.from }),
    })),
  },
  ...(faq.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.data.question,
          acceptedAnswer: { '@type': 'Answer', text: f.data.answer },
        })),
      }]
    : []),
];
let n = 0;
const next = () => String(++n).padStart(2, '0');
---
<Base title={title} description={description} path={`/${id}/`} jsonLd={jsonLd}>
  <PageHero icon={id} kicker={`${name}${kicker ? ` · ${kicker}` : ''} · ${duration}`} title={headline} accent={accent} intro={summary}>
    <Button href="/contact/">Plan een kennismaking</Button>
  </PageHero>
  {requires && (
    <div>
      <div class="mx-auto max-w-6xl px-4 pb-16 md:px-8">
        <p class="max-w-2xl border-t border-paper/15 pt-5 text-sage">Voorwaarde: {requires}</p>
      </div>
    </div>
  )}

  <Section id="signalen" n={next()} label="Signalen" title={signalsTitle}>
    <ul class="border-b border-paper/15">
      {signals.map((s) => <li class="border-t border-paper/15 py-5 font-display text-2xl md:text-3xl">{s}</li>)}
    </ul>
  </Section>

  <Section id="lever" n={next()} label="Oplevering" title={deliverablesTitle}>
    <ol class="grid gap-4 md:grid-cols-3">
      {deliverables.map((d, i) => (
        <li class="flex flex-col rounded-3xl border border-paper/15 p-8">
          <p class="flex justify-between text-sm text-paper/70"><span>0{i + 1}</span><span>{d.size}</span></p>
          <h3 class="mt-10 text-3xl">{d.name}</h3>
          <p class="mt-3 text-paper/80">{d.format}.</p>
        </li>
      ))}
    </ol>
    <slot name="after-deliverables" />
  </Section>

  <Section id="proces" n={next()} label="Proces" title={processTitle} intro={processIntro}>
    <ol class="border-b border-paper/15">
      {process.map((step) => (
        <li class="grid gap-1 border-t border-paper/15 py-5 md:grid-cols-[16rem_1fr_12rem] md:gap-8">
          <span class="font-medium">{step.when}</span>
          <span class="text-paper/80">{step.what}</span>
          <span class="text-sm text-paper/70 md:text-right">Jouw tijd: {step.clientTime}</span>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="prijs" n={next()} label="Prijs" title={priceTitle} intro={[priceIntro, proposal ? 'Voorstel, we bevestigen de prijs in de kennismaking.' : ''].filter(Boolean).join(' ')}>
    <ul class="grid gap-4 md:grid-cols-3">
      {prices.map((p) => (
        <li class="rounded-3xl border border-paper/15 p-8">
          <p class="text-sm text-paper/70">{p.label}</p>
          <p class="mt-6 font-display text-4xl tracking-[-0.01em] md:text-5xl">{priceLabel(p)}</p>
          <p class="mt-2 text-sm text-paper/70">{proposal ? 'Voorstel' : 'Vaste prijs'}</p>
        </li>
      ))}
    </ul>
    {priceNote && <p class="mt-6 text-paper/80">{priceNote}{proposal && ' Ook dit is een voorstel.'}</p>}
    <slot name="after-price" />
  </Section>

  <Section id="niet" n={next()} label="Niet inbegrepen" tone="dark" title="Wat er niet in zit">
    <ul class="border-b border-paper/15">
      {notIncluded.map((x) => <li class="border-t border-paper/15 py-5 font-display text-2xl md:text-3xl">{x}</li>)}
    </ul>
  </Section>

  {faq.length > 0 && (
    <Section id="vragen" n={next()} label="Vragen" title={`Vragen over ${name}`}>
      <Faq items={faq.map((f) => ({ question: f.data.question, answer: f.data.answer }))} />
    </Section>
  )}

  <section class="on-dark border-t border-paper/10" aria-labelledby="cta">
    <div class="mx-auto max-w-6xl px-4 py-24 md:px-8 md:py-32">
      <h2 id="cta" class="max-w-4xl text-4xl leading-[1.05] tracking-[-0.02em] md:text-6xl">Is {name} nu de juiste stap?</h2>
      <p class="mt-6 max-w-xl text-lg text-paper/80">In 30 minuten hoor je het. Ook als het antwoord "nog niet" is.</p>
      <div class="mt-10"><Button href="/contact/">Plan een kennismaking</Button></div>
    </div>
  </section>
</Base>
