---
// The offer in one card, three columns: the scan, what you get, and the price per step. Prices are proposals.
import { getEntry } from 'astro:content';
import Button from './Button.astro';
import { scan, monthly } from '../lib/offer';
import { priceLabel, euro } from '../lib/format';
const flow = await getEntry('services', 'flow');
if (!flow) throw new Error('Missing services/flow.json');
const gets = [
  ['De scan', 'Eén pagina met de drie grootste lekken in je opvolging, en wat elk lek per jaar kost met je eigen cijfers.'],
  ['De workflow', 'Een workflow uit de bibliotheek, gebouwd in HubSpot of ActiveCampaign, met e-mails, belopdrachten en een dashboard.'],
  ['Het beheer', 'Elke maand houden we de workflows draaiende, melden we volume, conversie en doorlooptijd en voegen we de volgende toe.'],
];
const prices = [
  { step: 'Stap 1, Scan', amount: scan.price, color: 'var(--color-blue)' },
  { step: 'Stap 2, Bouwen', amount: `${priceLabel(flow.data.prices[0])} per workflow`, color: 'var(--color-peach)' },
  { step: 'Stap 3, Beheren', amount: `Vanaf ${euro(monthly.from)} per maand`, color: 'var(--color-lilac)' },
];
---
<div class="card-brut grid overflow-hidden md:grid-cols-[1fr_1.2fr_1fr]">
  <div class="flex flex-col p-6 md:p-8">
    <h2 class="text-[2rem] leading-[1.05] md:text-[2.25rem]">{scan.name}</h2>
    <p class="mt-4 text-lg text-black/75">In {scan.minutes} minuten zien we welke contracten ongemerkt aflopen en welke offertes stilvallen. Daarna bouwen we de workflow die dat dicht, en houden we hem draaiende.</p>
    <div class="mt-8 md:mt-auto"><Button href={scan.slug}>Doe de opvolgscan</Button></div>
  </div>
  <div class="border-t-4 border-black p-6 md:border-l-4 md:border-t-0 md:p-8">
    <h3 class="text-base">Wat je krijgt:</h3>
    <ol class="mt-4 space-y-5">
      {gets.map(([t, d], i) => (
        <li class="grid grid-cols-[1.5rem_1fr] gap-3">
          <span class="font-bold">{i + 1}</span>
          <span><span class="block font-bold">{t}</span><span class="block text-black/75">{d}</span></span>
        </li>
      ))}
    </ol>
  </div>
  <div class="border-t-4 border-black p-6 md:border-l-4 md:border-t-0 md:p-8">
    <h3 class="text-base">Prijs per stap:</h3>
    <p class="text-sm text-black/65">Alles is een voorstel.</p>
    <div class="mt-4 space-y-4">
      {prices.map((p) => (
        <div class="border-l-4 pl-4" style={`border-color:${p.color}`}>
          <p class="text-sm">{p.step}</p>
          <p class="text-xl font-bold leading-tight tracking-[-0.03em]">{p.amount}</p>
        </div>
      ))}
    </div>
  </div>
</div>
