---
// The loop next to a list of the six phases with their workflow counts. Phases link into the library.
import type { CollectionEntry } from 'astro:content';
import Loop from './Loop.astro';
import { phases } from '../lib/loop';
import { topicHref, topicOf } from '../lib/topics';

interface Props {
  workflows: CollectionEntry<'workflows'>[];
}
const { workflows } = Astro.props;
const count = (id: string) => workflows.filter((w) => w.data.phase === id).length;
---
<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
  <div class="mx-auto w-full max-w-xl"><Loop /></div>
  <ol class="border-b border-fg/15">
    {phases.map((p, i) => (
      <li class="border-t border-fg/15">
        <a href={`${topicHref(topicOf(p.id))}#${p.id}`} class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-3 py-4 hover:text-accent">
          <span class="text-sm text-accent">0{i + 1}</span>
          <span>
            <span class="block font-medium">{p.name}</span>
            <span class="block text-sm text-muted">{p.revenue}</span>
          </span>
          <span class="text-sm text-fg/70">{count(p.id)} workflow{count(p.id) === 1 ? '' : 's'}</span>
        </a>
      </li>
    ))}
  </ol>
</div>
