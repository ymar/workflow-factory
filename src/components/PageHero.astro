---
import ProductIcon from './ProductIcon.astro';
interface Props {
  icon?: string;
  kicker: string;
  title: string;
  accent?: string;
  intro?: string;
  crumbs?: [string, string][];
}
const { icon, kicker, title, accent, intro, crumbs } = Astro.props;
---
<section class="hero-glow">
  <div class="mx-auto max-w-6xl px-4 pb-16 pt-10 md:px-8 md:pb-24 md:pt-16">
    {crumbs && (
      <nav aria-label="Kruimelpad" class="mb-10 text-sm text-muted md:mb-14">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          {crumbs.map(([href, label], i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <span aria-hidden="true">/</span>}
              {i < crumbs.length - 1 ? <a href={href} class="hover:text-accent hover:underline">{label}</a> : <span aria-current="page" class="text-fg">{label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">{icon && <ProductIcon id={icon} class="size-5 text-accent" />}{kicker}<slot name="meta" /></p>
    <h1 class="mt-4 max-w-4xl text-[2.5rem] leading-[1.02] tracking-[-0.035em] md:text-6xl">
      {title}{accent && <> <span class="neon-text">{accent}</span></>}
    </h1>
    {intro && <p class="mt-6 max-w-2xl text-lg text-fg/80 md:text-xl">{intro}</p>}
    {Astro.slots.has('default') && <div class="mt-8 flex flex-wrap gap-3"><slot /></div>}
    {Astro.slots.has('after') && <div class="mt-6"><slot name="after" /></div>}
  </div>
</section>
