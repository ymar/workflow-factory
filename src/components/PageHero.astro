---
import MediaIcon from './MediaIcon.astro';
interface Props {
  icon?: string;
  kicker: string;
  title: string;
  accent?: string;
  intro?: string;
}
const { icon, kicker, title, accent, intro } = Astro.props;
---
<section class="hero-glow">
  <div class="mx-auto max-w-6xl px-4 pb-16 pt-16 md:px-8 md:pb-28 md:pt-28">
    <p class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-sage">{icon && <MediaIcon id={icon} class="size-5 text-mint" />}{kicker}</p>
    <h1 class="mt-6 max-w-5xl text-[2.6rem] leading-[1.03] tracking-[-0.02em] md:text-7xl">
      {title}{accent && <> <span class="neon-text">{accent}</span></>}
    </h1>
    {intro && <p class="mt-8 max-w-2xl text-lg text-paper/80 md:text-xl">{intro}</p>}
    {Astro.slots.has('default') && <div class="mt-10 flex flex-wrap gap-3"><slot /></div>}
  </div>
</section>
