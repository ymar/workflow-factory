---
// Revenue Architecture bowtie: the left side runs to the first order, the right side to the second.
// Labels are HTML, not SVG text, so they stay readable on small screens.
---
<figure class="w-full">
  <svg viewBox="0 0 640 140" class="h-auto w-full" aria-hidden="true">
    <g fill="none" stroke-width="2" stroke-linejoin="round">
      <path d="M8 10 L320 70 L8 130 Z" stroke="#a9c4b6" />
      <path d="M632 10 L320 70 L632 130 Z" stroke="#5ff0b8" class="neon-tube" />
    </g>
    <circle cx="320" cy="70" r="6" fill="#5ff0b8" />
  </svg>
  <figcaption class="mt-5 grid grid-cols-[1fr_auto_1fr] gap-4 text-sm">
    <span>
      <span class="block text-xs font-medium uppercase tracking-[0.18em] text-sage">Naar de eerste order</span>
      <span class="mt-1 block text-paper/80">Aanvraag · Offerte</span>
    </span>
    <span class="text-center text-xs font-medium uppercase tracking-[0.18em] text-mint">Klant</span>
    <span class="text-right">
      <span class="block text-xs font-medium uppercase tracking-[0.18em] text-sage">Naar de tweede order</span>
      <span class="mt-1 block text-paper/80">Start · Gebruik · Verlenging · Groei</span>
    </span>
  </figcaption>
</figure>
