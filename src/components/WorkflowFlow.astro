---
// Flowchart of one workflow, drawn from its YAML. Each node links to the written-out step on the same page.
// Steps that start at the same moment sit side by side; time and conditions are labels on the arrows.
import type { CollectionEntry } from 'astro:content';
import { flowRows, stepRefs, whenLabel, withLabels } from '../lib/library';

interface Props {
  workflow: CollectionEntry<'workflows'>;
  labels: Map<string, string>;
  next?: CollectionEntry<'workflows'>;
}
const { workflow, labels, next } = Astro.props;
const { code, name, trigger, enroll, steps, exit, handover } = workflow.data;
const say = (text: string) => stepRefs(withLabels(text, labels));
const rows = flowRows(steps);
const number = new Map(steps.map((s, i) => [s.id, i + 1]));
type Step = (typeof steps)[number];

const icon: Record<string, string> = {
  'e-mail': '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  taak: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  melding: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
  systeem: '<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>',
  start: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  gate: '<path d="M12 3 21 12 12 21 3 12z"/>',
  wait: '<path d="M10 2h4"/><circle cx="12" cy="14" r="8"/><path d="M12 10v4"/>',
};
const tone: Record<string, string> = {
  'e-mail': 'bg-accent text-white',
  taak: 'bg-white text-fg ring-1 ring-fg/25',
  melding: 'bg-mint text-forest',
  systeem: 'bg-fg/10 text-fg/70',
};
const meta = (s: Step) =>
  s.action === 'e-mail' ? `E-mail · ${say(s.to ?? 'de klant').toLowerCase()}`
  : s.action === 'taak' ? `Taak · ${s.owner ?? 'eigenaar'}${s.sla ? ` · ${s.sla}` : ''}`
  : s.action === 'melding' ? `Melding · ${say(s.to ?? 'eigenaar').toLowerCase()}`
  : 'Systeem';
// Date-based workflows count from one date field, shown as T: "T−75 dagen" is 75 days before it.
const anchor = enroll.at?.match(/^([a-z]+\.[a-z_0-9]+)/)?.[1];
const units: Record<string, [string, string]> = { d: ['dag', 'dagen'], w: ['week', 'weken'], m: ['maand', 'maanden'] };
const moment = (s: Step) => {
  if (s.on) return undefined;
  if (s.at && s.at === enroll.at) return 'Direct bij de start';
  const m = s.at?.match(/^([a-z]+\.[a-z_0-9]+)\s*(?:([+-])\s*(\d+)([dwm]))?$/);
  if (m && m[1] === anchor) return m[2] ? `T${m[2] === '-' ? '−' : '+'}${m[3]} ${units[m[4]][m[3] === '1' ? 0 : 1]}` : 'Op T';
  return whenLabel(s, labels);
};
const fills = (s: Step) => (s.sets ? say(s.sets.split('=')[0].trim()) : undefined);
const svg = (name: string, cls: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${cls}" aria-hidden="true">${icon[name]}</svg>`;
const pill = 'relative inline-flex max-w-full items-center gap-1.5 rounded-lg border border-fg/15 bg-bg px-2 py-1 text-[11.5px] leading-tight text-fg/85';
---
<figure class="flow-canvas @container rounded-3xl border border-fg/15 p-4 sm:p-5">
  <figcaption class="flex items-center justify-between gap-4 text-xs font-medium uppercase tracking-[0.18em] text-muted">
    <span>Flowchart</span><span>{code}</span>
  </figcaption>
  <ol class="mt-4 flex flex-col items-center" aria-label={`Stappen van ${name.toLowerCase()}`}>
    <li class="on-dark w-full max-w-[26rem] rounded-2xl p-4">
      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.12em] text-accent"><Fragment set:html={svg('start', 'size-4')} />Start</p>
      <p class="mt-2 font-medium leading-snug">{trigger}</p>
      {anchor && <p class="mt-1 text-xs text-muted">T = {(labels.get(anchor) ?? anchor).toLowerCase()}</p>}
      <dl class="mt-3 grid grid-cols-[auto_1fr] items-baseline gap-x-3 gap-y-2 text-xs">
        {enroll.if.length > 0 && <><dt class="text-muted">Alleen als</dt><dd class="flex flex-wrap gap-1.5">{enroll.if.map((c) => <span class="rounded-md border border-fg/20 px-1.5 py-0.5">{say(c)}</span>)}</dd></>}
        {enroll.not_if.length > 0 && <><dt class="text-muted">Niet als</dt><dd class="flex flex-wrap gap-1.5">{enroll.not_if.map((c) => <span class="rounded-md border border-fg/20 px-1.5 py-0.5">{say(c)}</span>)}</dd></>}
        <dt class="text-muted">Stopt zodra</dt><dd class="flex flex-wrap gap-1.5">{exit.map((c) => <span class="rounded-md border border-fg/20 px-1.5 py-0.5">{say(c)}</span>)}</dd>
      </dl>
    </li>

    {rows.map((row) => {
      const fork = row.length > 1;
      const shared = moment(row[0]);
      return (
        <li class="w-full">
          <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 py-1.5">
            <span class="flex justify-end">
              {shared && <span class={pill}><Fragment set:html={svg('clock', 'size-3.5 shrink-0 text-muted')} />{shared}</span>}
              {row[0].on && <span class={pill}><Fragment set:html={svg('wait', 'size-3.5 shrink-0 text-muted')} />Zodra {say(row[0].on).toLowerCase()}</span>}
            </span>
            <span class="flow-line flow-arrow min-h-8 self-stretch" aria-hidden="true"></span>
            <span class="flex justify-start">
              {!fork && row[0].if && <span class={pill}><Fragment set:html={svg('gate', 'size-3 shrink-0 text-accent')} />Alleen als {say(row[0].if).toLowerCase()}</span>}
            </span>
          </div>
          <div class={`relative grid w-full gap-3 ${fork ? '@sm:grid-cols-2' : 'justify-items-center'}`}>
            {fork && <span class="flow-split absolute inset-x-1/4 top-0 hidden @sm:block" aria-hidden="true"></span>}
            {row.map((s) => (
              <div class={`flex flex-col items-center ${fork ? 'pt-0' : 'w-full max-w-[26rem]'}`}>
                {fork && (
                  <div class="flex w-full flex-col items-center gap-1.5 pb-1.5">
                    <span class="flow-line hidden h-3 @sm:block" aria-hidden="true"></span>
                    {s.if ? <span class={pill}><Fragment set:html={svg('gate', 'size-3 shrink-0 text-accent')} />Alleen als {say(s.if).toLowerCase()}</span> : <span class={pill}>Tegelijk</span>}
                  </div>
                )}
                <a href={`#stap-${s.id}`} class={`flow-node group flex w-full rounded-2xl border border-fg/15 bg-white p-3 transition-colors hover:border-accent/60 ${fork ? 'flex-col gap-2' : 'items-start gap-3'}`}>
                  <span class={`grid size-8 shrink-0 place-items-center rounded-lg ${tone[s.action]}`}><Fragment set:html={svg(s.action, 'size-4')} /></span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-xs text-muted">Stap {number.get(s.id)} · {meta(s)}</span>
                    <span class={`mt-0.5 block font-medium leading-snug break-words hyphens-auto group-hover:text-accent ${fork ? 'text-sm' : ''}`}>{s.title}</span>
                    {fills(s) && <span class="mt-1 block text-xs text-accent">Vult: {fills(s)}</span>}
                  </span>
                </a>
              </div>
            ))}
          </div>
        </li>
      );
    })}

    <li class="w-full">
      <div class="flex justify-center py-1.5"><span class="flow-line h-6" aria-hidden="true"></span></div>
      <div class={`relative grid w-full gap-3 ${handover.lost ? '@sm:grid-cols-2' : 'justify-items-center'}`}>
        {handover.lost && <span class="flow-split absolute inset-x-1/4 top-0 hidden @sm:block" aria-hidden="true"></span>}
        <div class="flex flex-col items-center">
          {handover.lost && <span class="flow-line hidden h-3 @sm:block" aria-hidden="true"></span>}
          <div class="w-full max-w-[26rem] rounded-2xl border border-accent/35 bg-mint/25 p-3">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent">Gelukt</p>
            <p class="mt-1 text-sm leading-snug">{handover.won}</p>
          </div>
        </div>
        {handover.lost && (
          <div class="flex flex-col items-center">
            <span class="flow-line hidden h-3 @sm:block" aria-hidden="true"></span>
            <div class="w-full rounded-2xl border border-fg/15 bg-white p-3">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">Niet gelukt</p>
              <p class="mt-1 text-sm leading-snug">{handover.lost}</p>
            </div>
          </div>
        )}
      </div>
    </li>
    {next && (
      <li class="flex w-full flex-col items-center">
        <span class="flow-line flow-line-dashed h-6" aria-hidden="true"></span>
        <a href={`/workflows/${next.id}/`} class="rounded-full border border-fg/25 bg-white px-4 py-2 text-sm font-medium hover:border-accent hover:text-accent">Daarna: {next.data.name} <span aria-hidden="true">→</span></a>
      </li>
    )}
  </ol>
</figure>
