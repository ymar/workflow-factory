---
// Services with prices, in the given order. `highlight` gets the dark card. Pass fewer ids in `order` to show fewer cards.
import { getCollection } from 'astro:content';
import ProductIcon from './ProductIcon.astro';
import { priceLabel } from '../lib/format';

interface Props {
  highlight?: string;
  badge?: string;
  order?: string[];
}
const { highlight = '', badge, order = ['flow', 'blueprint', 'build'] } = Astro.props;
const services = (await getCollection('services')).filter((s) => order.includes(s.id)).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---
<ul class={`grid gap-4 ${services.length === 3 ? "md:grid-cols-3" : "md:grid-cols-2"}`}>
  {services.map((s) => {
    const hl = s.id === highlight;
    return (
      <li class={`flex flex-col rounded-xl p-8 ${hl ? 'on-dark' : 'border border-fg/15'}`}>
        <div class="flex items-center justify-between">
          <ProductIcon id={s.id} class="size-8 text-accent" />
          {hl && badge && <span class="rounded-md bg-mint px-2 py-0.5 text-xs font-semibold text-forest">{badge}</span>}
        </div>
        <h3 class="mt-10 text-4xl">{s.data.name}</h3>
        <p class="mt-4 text-fg/80">{s.data.summary}</p>
        <dl class="mt-8 space-y-2 border-t border-fg/15 pt-6 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-muted">Doorlooptijd</dt><dd>{s.data.duration}</dd></div>
          {s.data.prices.map((p) => (
            <div class="flex justify-between gap-4"><dt class="text-muted">{p.label}</dt><dd class="text-right font-medium">{priceLabel(p)}</dd></div>
          ))}
        </dl>
        <p class="mt-3 text-xs text-muted">Voorstel{s.data.priceNote && `. ${s.data.priceNote}`}</p>
        <a href={`/${s.id}/`} class="group mt-auto inline-flex items-center gap-2 pt-10 font-medium text-accent">
          Meer over {s.data.name} <span aria-hidden="true" class="transition-transform motion-safe:group-hover:translate-x-0.5">→</span>
        </a>
      </li>
    );
  })}
</ul>
