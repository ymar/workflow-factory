---
// "Voor wie": the four sectors with one line in their words. Active sectors first.
import { getSectors, sectorHref } from '../lib/sectors';
const sectors = await getSectors();
---
<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {sectors.map((s) => (
    <li>
      <a href={sectorHref(s.data.slug)} class="group flex h-full flex-col rounded-xl border border-fg/15 bg-white p-6 transition-colors hover:border-accent/60">
        <span class="text-lg font-semibold tracking-[-0.015em]">{s.data.name}</span>
        <span class="mt-2 text-[15px] text-fg/80">“{s.data.problems[0]}”</span>
        <span aria-hidden="true" class="mt-auto pt-5 text-accent transition-transform motion-safe:group-hover:translate-x-0.5">→</span>
      </a>
    </li>
  ))}
</ul>
