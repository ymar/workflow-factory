---
import Logo from './Logo.astro';
import Placeholder from './Placeholder.astro';
import { site } from '../lib/site';
import { tracks, trackHref } from '../lib/tracks';
import { getSectors, sectorHref } from '../lib/sectors';
const sectors = await getSectors();
const year = new Date().getFullYear();
const columns = [
  { title: 'Uitkomsten', links: [['/workflows/', 'Alle workflows'], ...tracks.map((t) => [trackHref(t), t.name])] },
  { title: 'Branches', links: [['/branches/', 'Alle branches'], ...sectors.map((s) => [sectorHref(s.data.slug), s.data.name])] },
  { title: 'Diensten', links: [['/opvolgscan/', 'Opvolgscan'], ['/websitecheck/', 'Website check'], ['/flow/', 'Bouwen'], ['/diensten/#beheren', 'Beheren'], ['/blueprint/', 'Blueprint'], ['/build/', 'Build']] },
  { title: 'Meer', links: [['/workflows/crm/', 'Elk CRM'], ['/workflows/hubspot/', 'HubSpot'], ['/workflows/activecampaign/', 'ActiveCampaign'], ['/workflows/data/', 'Velden en metingen'], ['/teardowns/', 'Teardowns'], ['/over/', 'Over'], ['/contact/', 'Contact']] },
];
---
<footer class="on-dark">
  <div class="mx-auto max-w-6xl px-4 pb-10 pt-20 md:px-8 md:pt-24">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <Logo size="lg" />
        <p class="mt-6 max-w-sm text-lg text-fg/80">Meer onderhoudscontracten verlengd voor installatie- en onderhoudsbedrijven, met opvolging die vanzelf loopt.</p>
      </div>
      {columns.map((c) => (
        <div class="text-sm md:col-span-2 md:col-start-auto">
          <p class="text-[13px] text-muted">{c.title}</p>
          <ul class="mt-4 space-y-2">
            {c.links.map(([href, label]) => <li><a class="hover:text-accent" href={href}>{label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-16 flex flex-wrap justify-between gap-4 border-t border-fg/10 pt-6 text-xs text-muted">
      <p>© {year} Workflow Factory · Opbouw van de workflows onder <a class="underline underline-offset-4 hover:text-accent" href="https://creativecommons.org/licenses/by/4.0/deed.nl">CC BY 4.0</a></p>
      <p>KvK {site.kvk || <Placeholder label="KvK-nummer" />} · {site.email ? <a class="hover:text-accent" href={`mailto:${site.email}`}>{site.email}</a> : <Placeholder label="e-mailadres" />} · <a class="underline underline-offset-4 hover:text-accent" href="/privacy/">Privacy</a></p>
    </div>
  </div>
</footer>
