---
// "Dit is niets voor je als ...": who the offer is not for.
import { notFor } from '../lib/offer';
interface Props {
  title?: string;
}
const { title = 'Dit is niets voor je als' } = Astro.props;
---
<div class="max-w-3xl rounded-xl border-2 border-fg bg-white p-6 text-black md:p-8">
  <h3 class="text-2xl">{title}</h3>
  <ul class="mt-5 space-y-3">
    {notFor.map((t) => (
      <li class="grid grid-cols-[1.5rem_1fr] gap-2"><span aria-hidden="true" class="font-bold">✕</span><span>{t}</span></li>
    ))}
  </ul>
  <p class="mt-6 text-black/75">Twijfel je of het past? Plan de scan. We zeggen het eerlijk als het niet past.</p>
</div>
